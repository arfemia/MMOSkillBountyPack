# === 1.4.0: training (daily-board) + bihourly contracts ===

# --- Board names + descriptions (board titleKey/descriptionKey) ---
ui.bounty.board.bihourly = Schnellaufträge
ui.bounty.board.bihourly.desc = Ein kurzer Auftrag, der mehrmals am Tag wechselt.

# --- Daily board: training (XP-grind) contracts ---
quest.bounty_daily_woodcutting.title = Tagesholz
quest.bounty_daily_woodcutting.flavor = Die Sägewerke brauchen immer mehr Holz. Bring der Tafel einen stetigen Nachschub.
quest.bounty_daily_harvest.title = Tagesernte
quest.bounty_daily_harvest.flavor = Frische Erzeugnisse halten die Lager satt. Sammle, was die Felder heute hergeben.
quest.bounty_daily_fishing.title = Tagesfang
quest.bounty_daily_fishing.flavor = Die Köche wollen heute Abend Fisch auf dem Tisch. Arbeite an den Gewässern.
quest.bounty_daily_monster_cull.title = Tagesjagd
quest.bounty_daily_monster_cull.flavor = Irgendetwas muss immer ausgedünnt werden. Befrei die Wildnis von allem, was dir begegnet.
quest.bounty_daily_zombie_patrol.title = Zombie-Patrouille
quest.bounty_daily_zombie_patrol.flavor = Schon wieder Zombies am Tor. Irgendwer muss da raus.
quest.bounty_daily_bear_hunt.title = Bären im Vorratslager
quest.bounty_daily_bear_hunt.flavor = Bären haben die Vorräte geplündert. Die Tafel will die dreistesten von ihnen erlegt sehen.
quest.bounty_daily_essence.title = Essenz-Lieferung
quest.bounty_daily_essence.flavor = Den Alchemisten fehlt es an abgefülltem Leben. Gib eine Ladung an der Tafel ab.

# --- Bihourly board: short, fast-rotating contracts ---
quest.bounty_quick_build.title = Schnellbau
quest.bounty_quick_build.flavor = Vor der nächsten Schicht müssen ein paar Mauern hoch. Pack mit an.
quest.bounty_quick_bones.title = Schnelle Knochen
quest.bounty_quick_bones.flavor = Am Waldrand kriechen ständig Skelette herauf. Hau ein paar davon um.
quest.bounty_quick_ore.title = Schnellgrabung
quest.bounty_quick_ore.flavor = Die Schmiede wollen Kupfer, und zwar sofort. Bau eine Ader ab.
quest.bounty_quick_logs.title = Schnellhieb
quest.bounty_quick_logs.flavor = Ein kleiner Stapel Holz, so schnell du fällen kannst.
quest.bounty_quick_catch.title = Schnellwurf
quest.bounty_quick_catch.flavor = Gerade genug Fisch, um den Topf voll zu kriegen. Wirf die Angel aus.
quest.bounty_quick_cull.title = Schnelljagd
quest.bounty_quick_cull.flavor = Schon wieder Ärger an der Strasse. Räum aus, was dort lauert.
quest.bounty_quick_rot.title = Schnelle Verwesung
quest.bounty_quick_rot.flavor = Die Untoten sind wieder überall an der Straße. Leg ein paar um, bevor die nächste Patrouille vorbeikommt.

# --- Daily board: SPEND_CURRENCY showcase ---
quest.bounty_market_patron.title = Stammkunde des Marktes
quest.bounty_market_patron.flavor = Am Tresen läuft der Handel schleppend. Gib dort ein wenig aus, und die Tafel zahlt es dir zurück.

# === 1.3.0: Saisonaufträge (der Saisonplatz der Tagestafel, ausgehängt, solange ein Kalenderereignis läuft) ===

# --- Die Saisonstufe der Tagestafel (ihr Grades-Eintrag) ---
board.grade.seasonal = Saisonal

# --- Tagestafel: Spukaufträge zum Allerheiligenabend ---
quest.bounty_haunt_ghouls.title = Ghulsaison
quest.bounty_haunt_ghouls.flavor = Die hohlen Ghule kriechen nur raus, solange die Kürbisse brennen, und sie gehen direkt auf die Straßen los. Schick sie zurück unter die Erde, bevor die Saison vorbei ist.
quest.bounty_haunt_skeletons.title = Kürbisköpfe
quest.bounty_haunt_skeletons.flavor = Skelette tragen neuerdings geschnitzte Kürbisse, und sie ziehen jede Nacht über die Felder und grinsen die Bauernhäuser an. Hau ihnen die Köpfe ab und schick die Knochen wieder runter.
quest.bounty_haunt_souls.title = Wandernde Seelen
quest.bounty_haunt_souls.flavor = Nach Einbruch der Nacht treiben verlorene Seelen zwischen den Bäumen umher und suchen einen Weg nach Hause. Gib ihnen ihre Ruhe, bevor eine von ihnen jemandem zurück in die Stadt folgt.
