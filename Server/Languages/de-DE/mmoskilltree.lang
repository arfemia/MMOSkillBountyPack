shop.xp_all_skills.title = Allskill-XP-Paket
shop.xp_all_skills.desc = Ein wenig Erfahrung in jeder Fähigkeit auf einmal.
shop.boost_essence_surge.title = Essenz-Woge
shop.boost_essence_surge.desc = Für kurze Zeit lernt jede Fähigkeit schneller.
shop.cache_iron_bars.title = Schmiede-Reserve
shop.cache_iron_bars.desc = Eisenbarren aus der Gildenreserve.
shop.featured_cache_enchanter.title = Verzauberer-Paket
shop.featured_cache_enchanter.desc = Lila und blaue Kristallsplitter, in Stroh verpackt.

