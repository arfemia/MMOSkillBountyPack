# === 1.0.0 Content-Pass: neue Mob-Jagden, Sammeln-und-Liefern, Bosskontrakte ===

# --- Täglich: neues Töten ---
quest.bounty_scorpion_sweep.title = Skorpion-Säuberung
quest.bounty_scorpion_sweep.flavor = Skorpione haben sich unter den Dünen eingenistet und die Karawanen wollen sie los. Zertritt den Schwarm.
quest.bounty_cull_cactee.title = Wandelnde Kaktee
quest.bounty_cull_cactee.flavor = Die Kaktee haben ihre Wurzeln gezogen und streifen über die Ebene. Fäll sie, bevor sie die Straße erreichen.
quest.bounty_toad_rumble.title = Krötenkrawall
quest.bounty_toad_rumble.flavor = Nashornkröten drängen alles vom Wasserloch weg. Schlag die großen nieder.
quest.bounty_hunt_crocodile.title = Krokodiljagd
quest.bounty_hunt_crocodile.flavor = Krokodile haben sich in die Furt geschlichen, wo Leute queren. Räum die Ufer, bevor jemand ein Bein verliert.
quest.bounty_sabertooth_hunt.title = Säbelzahnjagd
quest.bounty_sabertooth_hunt.flavor = Ein Säbelzahn-Rudel hat den Höhenpfad eingenommen. Halt Abstand und nimm einen Bogen.
quest.bounty_raptor_cull.title = Raptor-Dezimierung
quest.bounty_raptor_cull.flavor = Höhlenraptoren jagen im Rudel rund um die Grabung. Dünn sie aus, damit die Bergleute arbeiten können.
quest.bounty_ghoul_purge.title = Ghul-Säuberung
quest.bounty_ghoul_purge.flavor = Ghule höhlen den alten Friedhof von unten aus. Leg die Fresser endgültig um.
quest.bounty_emberwulf_hunt.title = Glutwolf-Jagd
quest.bounty_emberwulf_hunt.flavor = Glutwölfe setzen die trockenen Kiefern in Brand, wo sie auch laufen. Streck sie nieder, bevor der Grat in Flammen aufgeht.

# --- Täglich: neues Sammeln (abbauen und liefern) ---
quest.bounty_mine_silver.title = Silberlieferung
quest.bounty_mine_silver.flavor = Der Münze fehlt Silber und der Prüfer will einen Teil geliefert. Arbeite die Adern ab und gib einen Anteil am Brett ab.

# --- Wöchentlich: neues Töten ---
quest.bounty_weekly_fen_stalkers.title = Pirscher des Moors
quest.bounty_weekly_fen_stalkers.flavor = Moorpirscher zerren immer wieder Vieh in den Sumpf. Geh ihnen hinterher.
quest.bounty_weekly_feran_pack.title = Das Feran-Rudel
quest.bounty_weekly_feran_pack.flavor = Feran-Scharfzähne haben den Grat besetzt und fallen über jeden her, der ihn überquert. Jag sie.
quest.bounty_weekly_yeti.title = Yeti der Gipfel
quest.bounty_weekly_yeti.flavor = Yetis sind von den weißen Gipfeln herabgestiegen und die Pässe sind nicht mehr sicher. Treib sie zurück in den Schnee.
quest.bounty_weekly_trillodon.title = Der Trillodon
quest.bounty_weekly_trillodon.flavor = Trillodons zertrampeln den Dschungel zwischen Fluss und Grat. Streck die Kolosse nieder.
quest.bounty_weekly_spirits.title = Ruhelose Geister
quest.bounty_weekly_spirits.flavor = An den Elementarkreisen haben sich wieder Geister gesammelt, und Besuch mögen sie nicht. Räum mit ihnen auf.
quest.bounty_weekly_voidspawn.title = Leerenbrut-Einfall
quest.bounty_weekly_voidspawn.flavor = Die Leere blutet wieder durch den Riss. Schlag nieder, was herauskriecht, bevor der Spalt sich weitet.
objective.text.bounty.voidspawn = Besiege {0} Leerenunholde
quest.bounty_weekly_mine_gold.title = Goldquote
quest.bounty_weekly_mine_gold.flavor = Gold für die Schatzkammer, und dort wird gezählt. Bau reichlich ab und gib ihren Anteil ab.

# --- Bossjagden (schwer, große Auszahlung) ---
quest.bounty_aberrant_horror.title = Aberranter Schrecken
quest.bounty_aberrant_horror.flavor = Etwas hat die Toten im Osten verdorben, und die aberranten fallen nicht leicht. Schlag weiter zu, bis sie es tun.
quest.bounty_weekly_goblin_duke.title = Der Goblin-Herzog
quest.bounty_weekly_goblin_duke.flavor = Der Bau gehorcht nun einem gekrönten Unhold. Beende den Herzog und die Überfälle enden mit ihm.
quest.bounty_weekly_shadow_knight.title = Gefallene Ritter
quest.bounty_weekly_shadow_knight.flavor = Skelettritter ziehen noch immer in ihrer alten Rüstung durch die Ruinen, die Schilde oben. Nimm Freunde mit, und etwas Schweres.
quest.bounty_weekly_broodmother.title = Die Brutmutter
quest.bounty_weekly_broodmother.flavor = Jeder Scarak in den Dünen schlüpft aus einer einzigen geschwollenen Königin. Finde sie im tiefen Nest und töte sie.

# --- Bosskämpfe (Bounty_Encounter-Aufträge: jeder skriptgesteuerte Boss zählt) ---
quest.bounty_weekly_open_warrant.title = Offener Steckbrief
quest.bounty_weekly_open_warrant.flavor = Kein Name auf diesem hier. Alles, was groß genug ist, um eine Gruppe zu brauchen, genügt, solange du noch im Kampf stehst, wenn es fällt.
quest.bounty_muster_roll.title = Der Appell
quest.bounty_muster_roll.flavor = Niemand verlangt, dass du gewinnst. Steh in einem Bosskampf, bis er entschieden ist, wie auch immer er ausgeht, und die Tafel vermerkt dich als anwesend.
objective.text.bounty.open_warrant = Bring {0} Boss zur Strecke
objective.text.bounty.muster_roll = Steh {0} Bosskampf bis zum Ende durch
objective.text.bounty.skeleton_knights = Besiege {0} Skelettritter
objective.text.bounty.burnt_skeletons = Besiege {0} verkohlte Skelette
