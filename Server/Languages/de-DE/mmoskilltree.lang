# MMOSkillBountyPack - Kopfgeld-Titel + Fließtext.
# Die Schlüssel stehen ohne Präfix; Hytales I18nModule stellt den Dateinamen voran, sodass jeder
# als mmoskilltree.quest.<id>.title / .flavor geladen und von der Kopfgeld-Tafel-UI aufgegriffen wird
# (BountyBoardPage löst quest.<id>.title / quest.<id>.flavor per Konvention auf).
# Füge eine <locale>/mmoskilltree.lang mit denselben Schlüsseln hinzu, um zu übersetzen; fehlende Schlüssel
# fallen pro Schlüssel auf Englisch zurück.

# --- Täglich: Töten ---
quest.bounty_swat_bats.title = Fledermäuse zerschlagen
quest.bounty_swat_bats.flavor = Die Fledermäuse in den Höhlen lassen die Bergleute bei jedem Schatten zusammenzucken. Räum mit ihnen auf.
quest.bounty_clear_spiders.title = Netze beseitigen
quest.bounty_clear_spiders.flavor = Spinnen haben die alten Pfade zugesponnen. Schaffe einen Durchgang, bevor jemand kopfüber in eines läuft.
quest.bounty_slay_zombies.title = Zombie-Keulung
quest.bounty_slay_zombies.flavor = Die ruhelosen Toten wandern zu nah an die Straße. Lege sie wieder um.
quest.bounty_cull_skeletons.title = Knochen klappern lassen
quest.bounty_cull_skeletons.flavor = Jede Dämmerung klettern Skelette aus den Grabhügeln. Schicke sie in Stücken zurück.
quest.bounty_hunt_wolves.title = Wolfsjagd
quest.bounty_hunt_wolves.flavor = Die Wölfe waren wieder bei den Schafen. Bring das Rudel zur Strecke.
quest.bounty_goblin_cleanup.title = Goblin-Säuberung
quest.bounty_goblin_cleanup.flavor = Goblins überfallen wieder die Versorgungskarren. Räume den Bau aus, dann überlegen sie es sich zweimal.
quest.bounty_cull_scaraks.title = Scarak-Keulung
quest.bounty_cull_scaraks.flavor = Scaraks quellen aus den Dünen empor. Dezimiere sie, solange sie noch verstreut sind.
quest.bounty_hunt_trork.title = Trork-Jagd
quest.bounty_hunt_trork.flavor = Trorks kommen immer wieder aus ihren Lagern in den Hügeln herunter und überfallen die Straße. Geh hinauf und stell dich ihnen.
quest.bounty_bear_hunt.title = Bärenjagd
quest.bounty_bear_hunt.flavor = Große Bären haben den Nordpfad in Besitz genommen. Diese hier ist nur etwas für eine ruhige Hand.
quest.bounty_smash_ogres.title = Festmeister zerschmettern
quest.bounty_smash_ogres.flavor = Goblin-Festmeister brechen durch die Palisaden. Bring sie zu Fall, bevor sie die Mauern mit sich reißen.
quest.bounty_snapdragon_hunt.title = Snapdragon-Jagd
quest.bounty_snapdragon_hunt.flavor = Die Dschungelpfade gehören den Snapdragons, und die Jäger gehen nicht in ihre Nähe. Erleg ein paar, und pass auf den Biss auf.
quest.bounty_burnt_skeletons.title = Asche und Knochen
quest.bounty_burnt_skeletons.flavor = Verkohlte Skelette wandern aus verbrannten Ruinen, immer noch glimmend. Leg die verbrannten Toten zurück zur Ruhe.
quest.bounty_boar_hunt.title = Wildschweinjagd
quest.bounty_boar_hunt.flavor = Wildschweine zertreten die Äcker und spießen jeden auf, der zu nah kommt. Dünne die Rotte aus, bevor die Ernte kommt.

# --- Täglich: Sammeln ---
quest.bounty_mine_stone.title = Steinbrucharbeit
quest.bounty_mine_stone.flavor = Die Maurer brauchen Stein, und reichlich davon. Leg dich ins Zeug.
quest.bounty_chop_wood.title = Holz!
quest.bounty_chop_wood.flavor = Der Holzlagerplatz läuft leer. Fälle, was du kannst, und stapele es hoch.
quest.bounty_mine_iron.title = Eisen für die Schmiede
quest.bounty_mine_iron.flavor = Den Schmieden ist das Eisen ausgegangen. Bring Erz aus den tiefen Adern zurück.
quest.bounty_mine_adamantite.title = Adamantit-Tour
quest.bounty_mine_adamantite.flavor = Adamantit sitzt nur in den tiefsten Adern. Nimm reichlich Fackeln mit.
quest.bounty_cache_copper.title = Kupfer-Vorrat
quest.bounty_cache_copper.flavor = Schlag ein paar Kupferadern für die Gießerei auf. Bezahlt wird in Barren.
quest.bounty_cache_repairs.title = Werkzeug des Handwerks
quest.bounty_cache_repairs.flavor = Brich Stein für den Steinbruch, und der Schmied legt für deine Mühe ein paar Reparatursätze drauf.

# --- Täglich: Trainieren ---
quest.bounty_train_woodcutting.title = Die Axt schärfen
quest.bounty_train_woodcutting.flavor = Der Holzplatz zahlt heute für Zeit an der Axt. Verbring sie am Waldrand.
quest.bounty_train_mining.title = Die Spitzhacke schwingen
quest.bounty_train_mining.flavor = Der Steinbruch zahlt heute nach Stunden. Verbring den Tag damit, Fels zu brechen.
quest.bounty_train_excavation.title = Tief graben
quest.bounty_train_excavation.flavor = Jemand will eine Menge Erde bewegt haben und ist nicht wählerisch, wohin. Fang an zu graben.

# --- Täglich: Liefern ---
quest.bounty_deliver_iron.title = Eisen-Lieferung
quest.bounty_deliver_iron.flavor = Der Quartiermeister kauft Eisenerz wagenweise. Bring es zur Tafel.
quest.bounty_deliver_hides.title = Häute-Fuhre
quest.bounty_deliver_hides.flavor = Die Gerber brauchen leichte Häute zu Karrenladungen. Liefere sie hier ab.
quest.bounty_deliver_essence.title = Essenz-Konsignation
quest.bounty_deliver_essence.flavor = Die Alchemisten zahlen gut für Lebensessenz. Gib ab, was du hast.
quest.bounty_deliver_adamantite.title = Adamantit-Konsignation
quest.bounty_deliver_adamantite.flavor = Die tiefen Schmieden wollen rohes Adamantiterz und zahlen gut dafür. Gib es an der Tafel ab.

# --- Wöchentlich ---
quest.bounty_weekly_slay_zombies.title = Die endlosen Toten
quest.bounty_weekly_slay_zombies.flavor = Eine ganze Woche ruheloser Toter. Halte die Stellung, bis die Gräber verstummen.
quest.bounty_weekly_hunt_trork.title = Trork-Kriegsbande
quest.bounty_weekly_hunt_trork.flavor = Eine ganze Kriegsbande hat ihr Lager aufgeschlagen. Schmälere sie im Laufe der Woche.
quest.bounty_weekly_goblin_purge.title = Goblin-Säuberung
quest.bounty_weekly_goblin_purge.flavor = Der Bau brütet ständig nach. Ihn auszudünnen dauert die ganze Woche.
quest.bounty_weekly_mine_adamantite.title = Adamantit-Quote
quest.bounty_weekly_mine_adamantite.flavor = Ein wochenlanger Vertrag für die tiefen Schmieden. Erfülle die Quote.
quest.bounty_weekly_outlander.title = Outlander-Kopfgeld
quest.bounty_weekly_outlander.flavor = Outlander-Plünderer überfallen die abgelegenen Höfe. Treibe sie zurück.
quest.bounty_weekly_burnt_legion.title = Die Verbrannte Legion
quest.bounty_weekly_burnt_legion.flavor = Verkohlte Tote marschieren aus den Aschelanden. Zerstreue die Legion ein für alle Mal.
quest.bounty_weekly_wraiths.title = Schemen-Jagd
quest.bounty_weekly_wraiths.flavor = Es treiben sich zu viele Schemen herum. Streck genug von ihnen nieder, damit die Leute wieder reisen.
quest.bounty_weekly_werewolves.title = Unter dem Vollmond
quest.bounty_weekly_werewolves.flavor = Der Mond ist die ganze Woche voll, und das Rudel läuft wild. Bring sie zur Strecke.
quest.bounty_weekly_golems.title = Golem-Brecher
quest.bounty_weekly_golems.flavor = Die Golems in den Ruinen sind auf den Beinen und laufen herum. Hau sie wieder zu Schutt.
quest.bounty_weekly_train_swords.title = Schwertmeisterschaft
quest.bounty_weekly_train_swords.flavor = Eine Woche Schwertdrill, jeden einzelnen Tag. Schlag zu, bis dein Arm die Arbeit kennt.
quest.bounty_weekly_train_defense.title = Halte die Stellung
quest.bounty_weekly_train_defense.flavor = Verbring die Woche damit, Treffer einzustecken und auf den Beinen zu bleiben. Nimm Verbände mit.
quest.bounty_weekly_sharks.title = Blutige Gewässer
quest.bounty_weekly_sharks.flavor = Die Fischer wollen die Hammerhaie weg von den warmen Riffen. Wo sie schwimmen, bleibt nichts, was sich zu fangen lohnt.
quest.bounty_weekly_leviathan.title = Waljagd
quest.bounty_weekly_leviathan.flavor = Jemand oben an der Küste will Wal, und sonst rudert keiner so weit hinaus. Such die Buckelwale auf offener See.
quest.bounty_weekly_sand_skeletons.title = Knochen der Dünen
quest.bounty_weekly_sand_skeletons.flavor = Vom Sand überwaschene Skelette kratzen überall empor, wo die Wüste die Toten verschlingt. Verbringe die Woche damit, die begrabene Horde aus den Dünen zu räumen.
quest.bounty_weekly_frost_skeletons.title = Die gefrorene Heerschar
quest.bounty_weekly_frost_skeletons.flavor = Gefrorene Skelette marschieren von den Gletschern herab. Zerschlag sie, bevor sie die Täler erreichen.

# --- Hub / Einführung (hier ausgeliefert, damit Serverbetreiber die Einführung umformulieren können, ---
# --- ohne das Jar anzufassen; das Jar behält diese englischen Werte als Rückfall pro Schlüssel). ---
ui.hub.subtitle = Was kann ich für dich tun, Abenteurer?
ui.hub.bounties_button = Kopfgelder ansehen
ui.hub.bounties_hint = Nimm rotierende Aufträge für Belohnungen an.
ui.hub.shop_button = Token-Shop
ui.hub.tutorial.step = {0} / {1}
ui.hub.tutorial.next = Weiter
ui.hub.tutorial.back = Zurück
ui.hub.tutorial.finish = Verstanden!
ui.hub.tutorial.welcome.title = Willkommen
ui.hub.tutorial.welcome.body = Ich bin der Kopfgeldmeister. Sprich mich jederzeit an, um Aufträge anzunehmen und zu handeln. So funktioniert's.
ui.hub.tutorial.bounties.title = Kopfgelder
ui.hub.tutorial.bounties.body = Kopfgelder sind Aufträge, die eine Weile an der Tafel hängen und dann gegen neue getauscht werden. Nimm eines an, um es deinem Questlog hinzuzufügen, schließe das Ziel ab, und du verdienst Token sowie XP. Wenn dir ein Auftrag nicht gefällt, kannst du ihn für ein paar Token neu auswürfeln.
ui.hub.tutorial.shop.title = Token-Shop
ui.hub.tutorial.shop.body = Gib die verdienten Token in meinem Token-Shop für XP-Boosts und Gegenstände aus. Manche vorgestellten Angebote rotieren täglich, und du kannst ein vorgestelltes Angebot neu auswürfeln, um es gegen ein anderes zu tauschen.

