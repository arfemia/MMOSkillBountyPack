shop.featured_cache_essence.title = Essenz-Fläschchen
shop.featured_cache_essence.desc = Lebensessenz, chargenweise abgefüllt.
shop.featured_cache_hides.title = Bündel leichter Häute
shop.featured_cache_hides.desc = Leichte Häute im Bündel, bereit für die Gerberei.
shop.featured_cache_lobster.title = Fischerfang
shop.featured_cache_lobster.desc = Hummer aus dem Wochenfang.
shop.featured_boost_combat.title = Klinge des Kriegers
shop.featured_boost_combat.desc = Für kurze Zeit gewinnst du schneller Schwerter-Erfahrung.
shop.featured_boost_woodcutting.title = Holzfäller-Rausch
