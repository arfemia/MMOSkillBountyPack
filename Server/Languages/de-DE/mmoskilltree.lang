# --- Filled translations (1.3.0 exhaustive localization pass; en-US key order) ---
shop.cache_copper_ore.title = Kupferkiste
shop.cache_copper_ore.desc = Eine Starterkiste mit rohem Kupfer. Keine Fragen.
shop.featured_cache_copper.title = Vorgestellt: Kupferkiste
shop.featured_cache_copper.desc = Eine vorgestellte Kiste mit glänzendem Rohkupfer.
shop.featured_cache_repair_kits.title = Vorgestellt: Feldreparaturen
shop.featured_cache_repair_kits.desc = Ein vorgestelltes Sortiment an Reparatursätzen, bereit für den Einsatz.
shop.featured_cache_copper_bars.title = Vorgestellt: Schmelzer-Bündel
shop.featured_cache_copper_bars.desc = Ein vorgestelltes Bündel direkt aus der Schmelze.
shop.featured_boost_defense.title = Bollwerks Entschlossenheit
shop.featured_boost_defense.desc = Jeder Schlag, den du überstehst, härtet dich weiter ab.
shop.featured_boost_excavation.title = Buddler-Eifer
shop.featured_boost_excavation.desc = Die Erde gibt ihre Geheimnisse bereitwillig preis.
