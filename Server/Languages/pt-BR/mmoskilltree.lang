shop.featured_boost_excavation.title = Fervor do Escavador
shop.featured_boost_excavation.desc = A experiência em Escavação vem mais rápido por pouco tempo.

# === Pacote de conteúdo 1.0.0: novas caçadas, coletar-e-entregar, contratos de chefe ===

# --- Diária: novo abate ---
quest.bounty_scorpion_sweep.title = Varredura de Escorpiões
quest.bounty_scorpion_sweep.flavor = Os escorpiões fizeram ninho sob as dunas e as caravanas os querem fora. Esmague o enxame.
quest.bounty_cull_cactee.title = Cactee Andantes
quest.bounty_cull_cactee.flavor = Os cactee se arrancaram pela raiz e vagam pelas planícies. Corte-os antes que cheguem à estrada.
quest.bounty_toad_rumble.title = Pancadaria de Sapos
quest.bounty_toad_rumble.flavor = Os sapos rinoceronte estão expulsando todos do bebedouro. Derrube os grandões.
quest.bounty_hunt_crocodile.title = Caça ao Crocodilo
quest.bounty_hunt_crocodile.flavor = Os crocodilos se meteram no vau onde o povo atravessa. Limpe as margens antes que alguém perca uma perna.
quest.bounty_sabertooth_hunt.title = Caça ao Dentes-de-Sabre
quest.bounty_sabertooth_hunt.flavor = Um bando de dentes-de-sabre tomou a trilha alta. Mantenha distância e use um arco.
quest.bounty_raptor_cull.title = Abate de Raptores
quest.bounty_raptor_cull.flavor = Os raptores das cavernas caçam em bando ao redor da escavação. Reduza-os para que os mineradores possam trabalhar.
quest.bounty_ghoul_purge.title = Expurgo de Carniçais
quest.bounty_ghoul_purge.flavor = Os carniçais esvaziam o velho cemitério por baixo. Acabe com os comedores de uma vez.
quest.bounty_emberwulf_hunt.title = Caça ao Lobo de Brasa
quest.bounty_emberwulf_hunt.flavor = Os lobos de brasa incendeiam os pinheiros secos por onde correm. Derrube-os antes que a crista pegue fogo.

# --- Diária: nova coleta (minerar e entregar) ---
quest.bounty_mine_silver.title = Consignação de Prata
quest.bounty_mine_silver.flavor = A casa da moeda está sem prata e o ensaiador quer uma parte entregue. Trabalhe as veias e entregue uma parcela ao quadro.

# --- Semanal: novo abate ---
quest.bounty_weekly_fen_stalkers.title = Espreitadores do Pântano
quest.bounty_weekly_fen_stalkers.flavor = Os espreitadores do pântano não param de arrastar o gado para o brejo. Entre atrás deles.
quest.bounty_weekly_feran_pack.title = A Matilha Feran
quest.bounty_weekly_feran_pack.flavor = Feran Dentes-Afiados tomaram a crista e atacam quem tenta atravessá-la. Cace-os.
quest.bounty_weekly_yeti.title = Yeti dos Picos
quest.bounty_weekly_yeti.flavor = Os yetis desceram dos picos brancos e os desfiladeiros já não são seguros. Faça-os voltar para a neve.
quest.bounty_weekly_trillodon.title = O Trillodon
quest.bounty_weekly_trillodon.flavor = Trillodons estão pisoteando a selva entre o rio e a crista. Derrube os brutamontes.
quest.bounty_weekly_spirits.title = Espíritos Inquietos
quest.bounty_weekly_spirits.flavor = Os espíritos se juntaram de novo nos círculos elementais, e não gostam de visitas. Expulse-os.
quest.bounty_weekly_voidspawn.title = Incursão do Vazio
quest.bounty_weekly_voidspawn.flavor = O vazio está sangrando pela fenda de novo. Derrube o que rastejar para fora antes que a brecha se alargue.
objective.text.bounty.voidspawn = Derrote {0} Demônios do Vazio
quest.bounty_weekly_mine_gold.title = Cota de Ouro
quest.bounty_weekly_mine_gold.flavor = Ouro para o tesouro, e eles estão contando. Minere bastante e entregue a parte deles.

# --- Caçadas de chefe (difícil, grande recompensa) ---
quest.bounty_aberrant_horror.title = Horror Aberrante
quest.bounty_aberrant_horror.flavor = Algo corrompeu os mortos a leste, e os aberrantes não caem fácil. Continue batendo até que caiam.
quest.bounty_weekly_goblin_duke.title = O Duque Goblin
quest.bounty_weekly_goblin_duke.flavor = O covil agora obedece a um bruto coroado. Acabe com o Duque e as pilhagens acabam com ele.
quest.bounty_weekly_shadow_knight.title = Cavaleiros Caídos
quest.bounty_weekly_shadow_knight.flavor = Cavaleiros esqueletos ainda percorrem as ruínas na armadura antiga, de escudo erguido. Leve amigos, e algo pesado.
quest.bounty_weekly_broodmother.title = A Rainha-Mãe
quest.bounty_weekly_broodmother.flavor = Cada Scarak das dunas eclode de uma única rainha inchada. Encontre-a no ninho profundo e mate-a.

# --- Lutas contra chefes (contratos Bounty_Encounter: qualquer chefe com script conta) ---
quest.bounty_weekly_open_warrant.title = Mandado Aberto
quest.bounty_weekly_open_warrant.flavor = Este não traz nome. Qualquer coisa grande o bastante para exigir um grupo serve, desde que você ainda esteja de pé na luta quando ela cair.
quest.bounty_muster_roll.title = A Chamada
quest.bounty_muster_roll.flavor = Ninguém está pedindo que você vença. Fique numa luta contra um chefe até ela se decidir, seja qual for o resultado, e o quadro marca a sua presença.
objective.text.bounty.open_warrant = Derrube {0} chefe
objective.text.bounty.muster_roll = Aguente {0} luta contra um chefe até o fim
