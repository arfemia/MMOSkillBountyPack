shop.featured_cache_essence.title = Frascos de Essência
shop.featured_cache_essence.desc = Essência da Vida, engarrafada por lote.
shop.featured_cache_hides.title = Pacote de Couro Leve
shop.featured_cache_hides.desc = Couros leves em pacote, prontos para o curtume.
shop.featured_cache_lobster.title = Carga do Pescador
shop.featured_cache_lobster.desc = Lagosta da pesca da semana.
shop.featured_boost_combat.title = Gume do Guerreiro
shop.featured_boost_combat.desc = A experiência em Espadas vem mais rápido por pouco tempo.
shop.featured_boost_woodcutting.title = Frenesi do Lenhador
shop.featured_boost_woodcutting.desc = A experiência em Lenhador vem mais rápido por pouco tempo.
shop.xp_all_skills.title = Pacote de XP de Todas as Habilidades
shop.xp_all_skills.desc = Um pouco de experiência em todas as habilidades de uma vez.
shop.boost_essence_surge.title = Onda de Essência
