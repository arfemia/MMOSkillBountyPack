# === 1.4.0: training (daily-board) + bihourly contracts ===

# --- Board names + descriptions (board titleKey/descriptionKey) ---
ui.bounty.board.bihourly = Contratos Rápidos
ui.bounty.board.bihourly.desc = Um contrato curto que se renova várias vezes ao dia.

# --- Daily board: training (XP-grind) contracts ---
quest.bounty_daily_woodcutting.title = Madeira Diária
quest.bounty_daily_woodcutting.flavor = Os pátios de madeira sempre precisam de mais toras. Traga ao quadro uma carga constante.
quest.bounty_daily_harvest.title = Colheita Diária
quest.bounty_daily_harvest.flavor = Produtos frescos mantêm os acampamentos alimentados. Colha o que os campos estão oferecendo hoje.
quest.bounty_daily_fishing.title = Pesca Diária
quest.bounty_daily_fishing.flavor = Os cozinheiros querem peixe na mesa esta noite. Trabalhe nas águas.
quest.bounty_daily_monster_cull.title = Abate Diário
quest.bounty_daily_monster_cull.flavor = Sempre há algo que precisa ser reduzido. Limpe as terras selvagens de tudo o que cruzar o seu caminho.
quest.bounty_daily_zombie_patrol.title = Patrulha Zumbi
quest.bounty_daily_zombie_patrol.flavor = Zumbis no portão de novo. Alguém tem que ir lá fora.
quest.bounty_daily_bear_hunt.title = Ursos nos Estoques
quest.bounty_daily_bear_hunt.flavor = Os ursos andam saqueando os estoques. O quadro quer os mais ousados deles abatidos.
quest.bounty_daily_essence.title = Entrega de Essência
quest.bounty_daily_essence.flavor = Os alquimistas estão com pouca vida engarrafada. Entregue um lote no quadro.

# --- Bihourly board: short, fast-rotating contracts ---
quest.bounty_quick_build.title = Construção Rápida
quest.bounty_quick_build.flavor = Algumas paredes precisam ser erguidas antes do próximo turno. Dê uma mão.
quest.bounty_quick_bones.title = Ossos Rápidos
quest.bounty_quick_bones.flavor = Esqueletos não param de rastejar perto da orla da floresta. Derrube alguns.
quest.bounty_quick_ore.title = Escavação Rápida
quest.bounty_quick_ore.flavor = Os ferreiros querem cobre, e querem agora. Trabalhe um veio.
quest.bounty_quick_logs.title = Corte Rápido
quest.bounty_quick_logs.flavor = Uma pequena pilha de toras, tão rápido quanto conseguir derrubá-las.
quest.bounty_quick_catch.title = Lance Rápido
quest.bounty_quick_catch.flavor = Peixe só o suficiente para completar a panela. Lance a linha.
quest.bounty_quick_cull.title = Abate Rápido
quest.bounty_quick_cull.flavor = Encrenca perto da estrada de novo. Limpe o que estiver à espreita.
quest.bounty_quick_rot.title = Putrefação Rápida
quest.bounty_quick_rot.flavor = Os mortos cambaleantes estão de novo perto da estrada. Abata alguns antes que a próxima patrulha chegue.

# --- Daily board: SPEND_CURRENCY showcase ---
quest.bounty_market_patron.title = Cliente do Mercado
quest.bounty_market_patron.flavor = O movimento anda fraco no balcão. Gaste um pouco lá e o quadro te devolve o valor.

# === 1.3.0: contratos sazonais (o espaço Sazonal do quadro Diário, publicado enquanto um evento do calendário acontece) ===

# --- A faixa Sazonal do quadro Diário (sua entrada em Grades) ---
board.grade.seasonal = Sazonal

# --- Quadro Diário: contratos de assombração da Noite das Bruxas ---
quest.bounty_haunt_ghouls.title = Temporada de Carniçais
quest.bounty_haunt_ghouls.flavor = Os carniçais ocos só saem rastejando enquanto as abóboras estão acesas, e vão direto para as estradas. Ponha-os de volta debaixo da terra antes que a temporada passe.
quest.bounty_haunt_skeletons.title = Cabeças de Abóbora
quest.bounty_haunt_skeletons.flavor = Os esqueletos deram de usar abóboras entalhadas, e andam pelos campos toda noite sorrindo para as casas de fazenda. Derrube as cabeças e mande os ossos de volta para a cova.
quest.bounty_haunt_souls.title = Almas Errantes
quest.bounty_haunt_souls.flavor = Almas perdidas vagam entre as árvores depois do anoitecer, procurando o caminho de casa. Dê descanso a elas antes que uma siga alguém de volta até a cidade.
