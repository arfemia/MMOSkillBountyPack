shop.featured_cache_repair_kits.title = Field Repairs
shop.featured_cache_repair_kits.desc = A few crude repair kits for the road.
shop.featured_cache_copper_bars.title = Smelter's Bundle
shop.featured_cache_copper_bars.desc = Copper ingots, straight from the smelter.
shop.featured_boost_defense.title = Bulwark's Resolve
