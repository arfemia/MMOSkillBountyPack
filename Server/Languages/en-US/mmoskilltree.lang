shop.cache_adamantite_ore.title = Adamantite Crate
shop.cache_adamantite_ore.desc = Deep-mined adamantite for seasoned fighters only.
shop.cache_scaled_hide.title = Hunter's Hide Bundle
shop.cache_scaled_hide.desc = Tough hides stripped from the deep hunters.
shop.featured_cache_iron.title = Featured: Iron Crate
shop.featured_cache_iron.desc = A featured crate of freshly mined iron.
shop.featured_cache_adamantite.title = Featured: Adamantite Stash
shop.featured_cache_adamantite.desc = A featured stash from the deepest veins.
shop.featured_cache_essence.title = Featured: Essence Vials
shop.featured_cache_essence.desc = A featured batch of bottled life.
shop.featured_cache_hides.title = Featured: Hide Bundle
shop.featured_cache_hides.desc = A featured bundle of supple hides.
shop.featured_cache_lobster.title = Featured: Fisher's Haul
shop.featured_cache_lobster.desc = A featured haul from the week's catch.
shop.featured_boost_combat.title = Warrior's Edge
shop.featured_boost_combat.desc = Your blade sings; every swing teaches you something.
shop.featured_boost_woodcutting.title = Lumberjack's Frenzy
shop.featured_boost_woodcutting.desc = Timber falls faster than you can count.
shop.featured_cache_copper.title = Featured: Copper Crate
shop.featured_cache_copper.desc = A featured crate of gleaming raw copper.
shop.featured_cache_repair_kits.title = Featured: Field Repairs
shop.featured_cache_repair_kits.desc = A featured set of kits, ready for the field.
shop.featured_cache_copper_bars.title = Featured: Smelter's Bundle
shop.featured_cache_copper_bars.desc = A featured bundle straight from the smelter.
shop.featured_boost_defense.title = Bulwark's Resolve
shop.featured_boost_defense.desc = Every blow you weather hardens you further.
shop.featured_boost_excavation.title = Digger's Fervor
shop.featured_boost_excavation.desc = The earth gives up its secrets willingly.
shop.xp_all_skills.title = All-Skills XP Bundle
shop.xp_all_skills.desc = A premium bundle of XP for every skill at once.
shop.boost_essence_surge.title = Essence Surge
shop.boost_essence_surge.desc = Channel raw life into insight; every skill learns faster while it lasts.
shop.cache_iron_bars.title = Smith's Reserve
shop.cache_iron_bars.desc = Smelted bars from the guild reserve, part-paid in essence.
shop.featured_cache_enchanter.title = Featured: Enchanter's Parcel
shop.featured_cache_enchanter.desc = A featured parcel of radiant crystals humming with charge.

