# === 1.4.0: training (daily-board) + bihourly contracts ===

# --- Board names + descriptions (board titleKey/descriptionKey) ---
ui.bounty.board.bihourly = Quick Contracts
ui.bounty.board.bihourly.desc = A short contract that rotates several times a day.

# --- Daily board: training (XP-grind) contracts ---
quest.bounty_daily_woodcutting.title = Daily Timber
quest.bounty_daily_woodcutting.flavor = The lumber yards always need more logs. Bring the board a steady haul.
quest.bounty_daily_harvest.title = Daily Harvest
quest.bounty_daily_harvest.flavor = Fresh produce keeps the camps fed. Gather what the fields are offering today.
quest.bounty_daily_fishing.title = Daily Catch
quest.bounty_daily_fishing.flavor = The cooks want fish on the table tonight. Work the waters.
quest.bounty_daily_monster_cull.title = Daily Cull
quest.bounty_daily_monster_cull.flavor = Something always needs thinning out. Clear the wilds of whatever crosses your path.
quest.bounty_daily_zombie_patrol.title = Zombie Patrol
quest.bounty_daily_zombie_patrol.flavor = Zombies at the gate again. Somebody has to go out there.
quest.bounty_daily_bear_hunt.title = Bears in the Stores
quest.bounty_daily_bear_hunt.flavor = Bears have been raiding the stores. The board wants the boldest of them culled.
quest.bounty_daily_essence.title = Essence Delivery
quest.bounty_daily_essence.flavor = The alchemists are short on bottled life. Hand a batch in at the board.

# --- Bihourly board: short, fast-rotating contracts ---
quest.bounty_quick_build.title = Quick Build
quest.bounty_quick_build.flavor = A few walls need raising before the next shift. Lend a hand.
quest.bounty_quick_bones.title = Quick Bones
quest.bounty_quick_bones.flavor = Skeletons keep crawling up near the treeline. Knock a few down.
quest.bounty_quick_ore.title = Quick Dig
quest.bounty_quick_ore.flavor = The smiths want copper, and they want it now. Work a vein.
quest.bounty_quick_logs.title = Quick Chop
quest.bounty_quick_logs.flavor = A short stack of logs, fast as you can fell them.
quest.bounty_quick_catch.title = Quick Cast
quest.bounty_quick_catch.flavor = Just enough fish to round out the pot. Cast a line.
quest.bounty_quick_cull.title = Quick Cull
quest.bounty_quick_cull.flavor = Trouble near the road again. Clear out whatever is lurking.
quest.bounty_quick_rot.title = Quick Rot
quest.bounty_quick_rot.flavor = The shambling dead are thick near the road again. Drop a few before the next patrol comes through.

# --- Daily board: SPEND_CURRENCY showcase ---
quest.bounty_market_patron.title = Market Patron
quest.bounty_market_patron.flavor = Trade is slow at the counter. Spend a little there and the board will pay you back for it.

# === 1.3.0: seasonal contracts (the Daily board's Seasonal slot, posted while a calendar event runs) ===

# --- The Daily board's Seasonal band (its Grades entry) ---
board.grade.seasonal = Seasonal

# --- Daily board: Hallow's Eve haunt contracts ---
quest.bounty_haunt_ghouls.title = Ghoul Season
quest.bounty_haunt_ghouls.flavor = The hollow ghouls only crawl out while the pumpkins are lit, and they go straight for the roads. Put them back in the ground before the season turns.
quest.bounty_haunt_skeletons.title = Pumpkin Heads
quest.bounty_haunt_skeletons.flavor = Skeletons have taken to wearing carved pumpkins, and they walk the fields every night grinning at the farmhouses. Knock the heads off and send the bones back down.
quest.bounty_haunt_souls.title = Wandering Souls
quest.bounty_haunt_souls.flavor = Lost souls drift between the trees after nightfall, looking for a way home. Give them their rest before one of them follows somebody back to town.
