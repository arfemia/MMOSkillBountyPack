shop.general.desc = Alın teriyle kazandığın jetonları boostlara, kasalara ve öne çıkan fırsatlara harca.
shop.xpexchange.title = XP Takası
shop.xpexchange.desc = Kazancını bir patlama yetenek XP'siyle takas et.
shop.xpexchange.featured = Bugünün XP Fırsatları

# --- Mağaza teklifi adları + açıklamaları (teklifler açık titleKey/descriptionKey ayarlar -> bu anahtarlar) ---
shop.boost_mining.title = Madencilik Hücumu
shop.boost_mining.desc = Yoğunlaşmış madenci içgüdüsünden bir patlama; kaya neredeyse kendiliğinden açılıyor.
shop.boost_all_skills.title = Tüm Yetenek Dalgası
shop.boost_all_skills.desc = Sahip olduğun her yeteneği keskinleştiren bir kavrayış dalgası.
shop.cache_iron_ore.title = Demir Sandığı
shop.cache_iron_ore.desc = Sağlam bir demir sandığı, doğrudan envanterine teslim edilir.
shop.cache_adamantite_ore.title = Adamantit Sandığı
shop.cache_adamantite_ore.desc = Derinlerden çıkarılmış adamantit, yalnızca deneyimli dövüşçüler için.
shop.cache_scaled_hide.title = Avcının Post Demeti
shop.cache_scaled_hide.desc = Derin avcılardan soyulmuş sert postlar.
shop.featured_cache_iron.title = Öne Çıkan: Demir Sandığı
shop.featured_cache_iron.desc = Taze kazılmış demirden öne çıkan bir sandık.
shop.featured_cache_adamantite.title = Öne Çıkan: Adamantit Zulası
shop.featured_cache_adamantite.desc = En derin damarlardan öne çıkan bir zula.
shop.featured_cache_essence.title = Öne Çıkan: Öz Şişeleri
shop.featured_cache_essence.desc = Şişelenmiş yaşamdan öne çıkan bir parti.
shop.featured_cache_hides.title = Öne Çıkan: Post Demeti
shop.featured_cache_hides.desc = Yumuşak postlardan öne çıkan bir demet.
shop.featured_cache_lobster.title = Öne Çıkan: Balıkçının Avı
shop.featured_cache_lobster.desc = Haftanın avından öne çıkan bir yük.
shop.featured_boost_combat.title = Savaşçının Keskinliği
shop.featured_boost_combat.desc = Kılıcın şarkı söylüyor; her savuruş sana bir şey öğretiyor.
shop.featured_boost_woodcutting.title = Oduncunun Çılgınlığı
shop.featured_boost_woodcutting.desc = Kereste sayabileceğinden hızlı deviriliyor.
shop.xp_all_skills.title = Tüm Yetenek XP Paketi
shop.xp_all_skills.desc = Her yetenek için aynı anda premium bir XP paketi.
shop.boost_essence_surge.title = Öz Dalgası
shop.boost_essence_surge.desc = Ham yaşamı kavrayışa dönüştür; sürdüğü sürece her yetenek daha hızlı öğrenir.
shop.cache_iron_bars.title = Demircinin Rezervi
shop.cache_iron_bars.desc = Lonca rezervinden eritilmiş külçeler, bedelinin bir kısmı özle ödenmiş.
shop.featured_cache_enchanter.title = Öne Çıkan: Büyücünün Paketi
shop.featured_cache_enchanter.desc = Yükle uğuldayan ışıltılı kristallerden öne çıkan bir paket.

