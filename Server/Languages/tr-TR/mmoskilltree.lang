# MMOSkillBountyPack - ödül başlıkları + atmosfer metni.
# Anahtarlar çıplaktır; Hytale'in I18nModule dosya adını başa ekler, böylece her biri
# mmoskilltree.quest.<id>.title / .flavor olarak yüklenir ve Ödül Tahtası arayüzü tarafından alınır
# (BountyBoardPage, quest.<id>.title / quest.<id>.flavor anahtarlarını kurala göre çözer).
# Çevirmek için aynı anahtarlarla bir <locale>/mmoskilltree.lang ekleyin; eksik anahtarlar
# anahtar bazında İngilizceye geri döner.

# --- Günlük: öldürme ---
quest.bounty_swat_bats.title = Yarasaları Ez
quest.bounty_swat_bats.flavor = Bu gece mağaralar deri kanatlılarla dolu. Bir yuva kurmadan önce sürüyü seyrelt.
quest.bounty_clear_spiders.title = Ağları Temizle
quest.bounty_clear_spiders.flavor = Örümcekler eski yolları örerek kapadı. Biri yüzü önde içine yürümeden önce bir geçit aç.
quest.bounty_slay_zombies.title = Zombi İtlafı
quest.bounty_slay_zombies.flavor = Huzursuz ölüler yola fazla yaklaşıyor. Onları geri yatır.
quest.bounty_cull_skeletons.title = Kemikleri Şıngırdat
quest.bounty_cull_skeletons.flavor = İskeletler her akşam karanlığında mezarlardan tırmanıyor. Onları parça parça geri gönder.
quest.bounty_hunt_wolves.title = Kurt Avı
quest.bounty_hunt_wolves.flavor = Bir sürü meraların yakınında fazla cesurlaştı. Sürüler bedelini ödemeden onları avla.
quest.bounty_goblin_cleanup.title = Goblin Temizliği
quest.bounty_goblin_cleanup.flavor = Goblinler yine erzak arabalarına saldırıyor. İni temizle, iki kez düşünsünler.
quest.bounty_cull_scaraks.title = Scarak İtlafı
quest.bounty_cull_scaraks.flavor = Scaraklar kumullardan kaynayıp çıkıyor. Hâlâ dağınıkken onları seyrelt.
quest.bounty_hunt_trork.title = Trork Avı
quest.bounty_hunt_trork.flavor = Trork savaş takımları tepelerde toplanıyor. Örgütlenmeden önce sayılarını kır.
quest.bounty_bear_hunt.title = Ayı Avı
quest.bounty_bear_hunt.flavor = Büyük ayılar kuzey patikasını ele geçirdi. Bu yalnızca sağlam ellere göre.
quest.bounty_smash_ogres.title = Devleri Ezme
quest.bounty_smash_ogres.flavor = Devler palisadları parçalıyor. Duvarlar onlarla birlikte gelmeden önce indir.
quest.bounty_hunt_risen.title = Dirilenleri Yatır
quest.bounty_hunt_risen.flavor = Ölüler gömülü kalmayacak. Dirilenleri toprağa geri koy.

# --- Günlük: toplama ---
quest.bounty_mine_stone.title = Taş Ocağı İşi
quest.bounty_mine_stone.flavor = Duvarcıların taşa, hem de bolca taşa ihtiyacı var. Kazmaya koyul.
quest.bounty_chop_wood.title = Devrilen Ağaç
quest.bounty_chop_wood.flavor = Kereste deposu tükeniyor. Kesebildiğini kes ve yüksekçe istifle.
quest.bounty_mine_iron.title = Ocak İçin Demir
quest.bounty_mine_iron.flavor = Demircilerin demiri kalmadı. Derin damarlardan cevher getir.
quest.bounty_mine_adamantite.title = Adamantit Seferi
quest.bounty_mine_adamantite.flavor = Adamantit yalnızca en derin damarlarda bulunur. Karanlığa cesaret edersen çıkar.
quest.bounty_cache_copper.title = Bakır Stoku
quest.bounty_cache_copper.flavor = Dökümhane ham bakır karşılığında taze eritilmiş külçe verir. Cevher getir, metalle ayrıl.
quest.bounty_cache_repairs.title = İşin Aletleri
quest.bounty_cache_repairs.flavor = Taş ocağı için taş kır, demirci de zahmetin karşılığında birkaç tamir kiti ekler.

# --- Günlük: eğitim ---
quest.bounty_train_woodcutting.title = Baltayı Bile
quest.bounty_train_woodcutting.flavor = Pratik daha hızlı bir kesiş sağlar. Günü ağaç sırasında geçir.
quest.bounty_train_mining.title = Kazmayı Çalıştır
quest.bounty_train_mining.flavor = Bir madencinin değeri vuruşlarıyla ölçülür. Saatlerini harca.
quest.bounty_train_excavation.title = Derine Kaz
quest.bounty_train_excavation.flavor = Bir kazıcının nasırlarına kestirme yol yoktur. Biraz toprak kaldır.

# --- Günlük: teslimat ---
quest.bounty_deliver_iron.title = Demir Teslimatı
quest.bounty_deliver_iron.flavor = Levazımcı demir için iyi para öder, soru sormadan. Tahtaya getir.
quest.bounty_deliver_hides.title = Post Taşıma
quest.bounty_deliver_hides.flavor = Tabakçılar araba dolusu hafif post istiyor. Onları buraya bırak.
quest.bounty_deliver_essence.title = Öz Sevkiyatı
quest.bounty_deliver_essence.flavor = Şişelenmiş yaşam özü bir servet eder. Stokunu teslim et.
quest.bounty_deliver_adamantite.title = Adamantit Sevkiyatı
quest.bounty_deliver_adamantite.flavor = Usta eller adamantit ister ve yalnızca en iyi cevher işe yarar.

# --- Haftalık ---
quest.bounty_weekly_slay_zombies.title = Bitmek Bilmeyen Ölüler
quest.bounty_weekly_slay_zombies.flavor = Bir haftalık huzursuz ölü. Mezarlar sessizleşene kadar hattı tut.
quest.bounty_weekly_hunt_trork.title = Trork Savaş Takımı
quest.bounty_weekly_hunt_trork.flavor = Tam bir savaş takımı kamp kurdu. Hafta boyunca onu yontup azalt.
quest.bounty_weekly_goblin_purge.title = Goblin Tasfiyesi
quest.bounty_weekly_goblin_purge.flavor = İn üremeye devam ediyor. Gerçekten seyreltmek bir haftalık iş ister.
quest.bounty_weekly_mine_adamantite.title = Adamantit Kotası
quest.bounty_weekly_mine_adamantite.flavor = Derin ocaklar için bir haftalık sözleşme. Kotayı doldur.
quest.bounty_weekly_outlander.title = Outlander Ödülü
quest.bounty_weekly_outlander.flavor = Outlanderlar hafta boyunca sınırları zorluyor. Onları geri püskürt.
quest.bounty_weekly_burnt_legion.title = Yanık Lejyon
quest.bounty_weekly_burnt_legion.flavor = Kavrulmuş ölüler kül topraklarından yürüyor. Lejyonu temelli dağıt.
quest.bounty_weekly_wraiths.title = Hayalet Avı
quest.bounty_weekly_wraiths.flavor = Hayaletler bu dünya ile öteki arasında kayıp gidiyor. Fark yaratacak kadarını kov.
quest.bounty_weekly_werewolves.title = Dolunay Altında
quest.bounty_weekly_werewolves.flavor = Ay hafta boyunca dolunay ve sürü çılgına dönüyor. Laneti sona erdir.
quest.bounty_weekly_golems.title = Golem Kırıcı
quest.bounty_weekly_golems.flavor = Antik golemler harabelerde uyandı. Onları taş taş parçala.
quest.bounty_weekly_train_swords.title = Kılıç Ustalığı
quest.bounty_weekly_train_swords.flavor = Bir haftalık talim, bir askeri kılıç ustasından ayırır. Sıkı çalış.
quest.bounty_weekly_train_defense.title = Hattı Tut
quest.bounty_weekly_train_defense.flavor = Dayanıklılık darbe darbe kazanılır. Haftayı darbe alarak ve sağlam durarak geçir.
quest.bounty_weekly_sharks.title = Kanlı Sular
quest.bounty_weekly_sharks.flavor = Çekiç başlı köpekbalıkları nakliye yollarını av sahasına çevirdi. Bir sonraki mürettebat kaybolmadan sürüyü seyrelt.
quest.bounty_weekly_leviathan.title = Leviathan
quest.bounty_weekly_leviathan.flavor = Dalgaların altında devasa bir şey kımıldıyor. Filoyu derine çekmeden önce büyük canavarları indir.

