# --- Filled translations (1.3.0 exhaustive localization pass; en-US key order) ---
shop.cache_copper_ore.title = Cassa di Rame
shop.cache_copper_ore.desc = Una cassa iniziale di rame grezzo. Senza fare domande.
shop.featured_cache_copper.title = In Evidenza: Cassa di Rame
shop.featured_cache_copper.desc = Una cassa in evidenza di rame grezzo luccicante.
shop.featured_cache_repair_kits.title = In Evidenza: Riparazioni da Campo
shop.featured_cache_repair_kits.desc = Un set in evidenza di kit, pronti per il campo.
shop.featured_cache_copper_bars.title = In Evidenza: Fascio del Fonditore
shop.featured_cache_copper_bars.desc = Un fascio in evidenza dritto dalla fonderia.
shop.featured_boost_defense.title = Fermezza del Baluardo
shop.featured_boost_defense.desc = Ogni colpo che incassi ti tempra ancora di piu'.
shop.featured_boost_excavation.title = Fervore dello Scavatore
shop.featured_boost_excavation.desc = La terra cede i suoi segreti di buon grado.

# === Aggiornamento contenuti 1.0.0: nuove cacce, raccogli-e-consegna, contratti boss ===

# --- Giornaliere: nuova uccisione ---
quest.bounty_scorpion_sweep.title = Spazzata di Scorpioni
quest.bounty_scorpion_sweep.flavor = Gli scorpioni hanno fatto il nido sotto le dune e le carovane li vogliono via. Schiaccia lo sciame.
quest.bounty_cull_cactee.title = Problema Spinoso
quest.bounty_cull_cactee.flavor = I cactee si sono sradicati e vagano per le piane. Abbattili prima che raggiungano la strada.
quest.bounty_toad_rumble.title = Rissa di Rospi
quest.bounty_toad_rumble.flavor = I rospi rinoceronte scacciano tutti dalla pozza. Stendi quelli grossi.
quest.bounty_hunt_crocodile.title = Caccia al Coccodrillo
quest.bounty_hunt_crocodile.flavor = I coccodrilli si sono infilati nel guado dove si attraversa. Libera le rive prima che qualcuno ci rimetta una gamba.
quest.bounty_sabertooth_hunt.title = Caccia allo Smilodonte
quest.bounty_sabertooth_hunt.flavor = Un branco di smilodonti si aggira sul sentiero alto. Falli fuori dalla distanza prima che facciano fuori i viandanti.
quest.bounty_raptor_cull.title = Abbattimento di Raptor
quest.bounty_raptor_cull.flavor = I raptor delle caverne cacciano in branco attorno allo scavo. Diradali perche' i minatori possano lavorare.
quest.bounty_ghoul_purge.title = Purga dei Ghoul
quest.bounty_ghoul_purge.flavor = I ghoul svuotano il vecchio cimitero dal basso. Stendi i divoratori una volta per tutte.
quest.bounty_emberwulf_hunt.title = Caccia al Lupo di Brace
quest.bounty_emberwulf_hunt.flavor = I lupi di brace danno fuoco ai pini secchi ovunque corrano. Abbattili prima che il crinale vada a fuoco.

# --- Giornaliere: nuova raccolta (estrai e consegna) ---
quest.bounty_mine_silver.title = Carico d'Argento
quest.bounty_mine_silver.flavor = Alla zecca manca l'argento e il saggiatore ne vuole una parte consegnata. Lavora le vene, poi consegna una quota alla bacheca.

# --- Settimanali: nuova uccisione ---
quest.bounty_weekly_fen_stalkers.title = Predatori della Palude
quest.bounty_weekly_fen_stalkers.flavor = Per tutta la settimana i predatori della palude hanno trascinato il bestiame nel fango. Cacciali per l'acquitrino finche' la melma non tace.
quest.bounty_weekly_feran_pack.title = Il Branco Feran
quest.bounty_weekly_feran_pack.flavor = Un branco da caccia feran ha reclamato il crinale. Ci vuole una settimana di lavoro per spezzarne la presa.
quest.bounty_weekly_yeti.title = Yeti delle Vette
quest.bounty_weekly_yeti.flavor = Gli yeti sono scesi dalle vette bianche e i valichi non sono piu' sicuri. Ricacciali nella neve.
quest.bounty_weekly_trillodon.title = Terrore Trillodon
quest.bounty_weekly_trillodon.flavor = Un trillodon calpesta tutto tra il fiume e il crinale. Abbatti il colosso.
quest.bounty_weekly_spirits.title = Spiriti Inquieti
quest.bounty_weekly_spirits.flavor = Per tutta la settimana spiriti elementali si liberano dagli antichi santuari. Mettili a riposo prima che i sigilli cedano.
quest.bounty_weekly_voidspawn.title = Incursione del Vuoto
quest.bounty_weekly_voidspawn.flavor = Il vuoto trasuda di nuovo dalla faglia. Abbatti cio' che ne striscia fuori prima che la breccia si allarghi.
quest.bounty_weekly_mine_gold.title = Quota d'Oro
quest.bounty_weekly_mine_gold.flavor = Un contratto di una settimana per il tesoro. Estrai l'oro dalla roccia profonda e consegna la quota concordata.

# --- Cacce ai boss (difficile, grande ricompensa) ---
quest.bounty_aberrant_horror.title = Orrore Aberrante
quest.bounty_aberrant_horror.flavor = Qualcosa ha corrotto i morti a oriente, e gli aberranti non cadono facilmente. Fatti coraggio e poni loro fine.
quest.bounty_weekly_goblin_duke.title = Il Duca Goblin
quest.bounty_weekly_goblin_duke.flavor = La tana ora risponde a un bruto coronato. Poni fine al Duca e le razzie finiscono con lui.
quest.bounty_weekly_shadow_knight.title = Il Cavaliere d'Ombra
quest.bounty_weekly_shadow_knight.flavor = Un'ombra corazzata percorre le rovine, e l'acciaio la morde a malapena. Pochi che affrontano il cavaliere tornano. Sii uno di loro.
quest.bounty_weekly_broodmother.title = La Madre della Covata
quest.bounty_weekly_broodmother.flavor = Ogni scarak delle dune nasce da una regina gonfia. Trovala nel nido profondo e poni fine alla covata alla fonte.

# --- Scontri con i boss (contratti Bounty_Encounter: conta qualsiasi boss con script) ---
quest.bounty_weekly_open_warrant.title = Mandato Aperto
quest.bounty_weekly_open_warrant.flavor = Questo non porta nome. Qualunque cosa abbastanza grossa da richiedere un gruppo va bene, purché tu sia ancora in piedi nello scontro quando cade.
quest.bounty_muster_roll.title = L'Appello
quest.bounty_muster_roll.flavor = Nessuno ti chiede di vincere. Resisti in uno scontro con un boss finché non è deciso, comunque vada, e la bacheca ti segna presente.
objective.text.bounty.open_warrant = Abbatti {0} boss
objective.text.bounty.muster_roll = Resisti in {0} scontro con un boss fino alla fine

# === 1.4.0: training (daily-board) + bihourly contracts ===

# --- Board names + descriptions (board titleKey/descriptionKey) ---
ui.bounty.board.bihourly = Contratti Rapidi
ui.bounty.board.bihourly.desc = Un breve contratto che ruota più volte al giorno.

# --- Daily board: training (XP-grind) contracts ---
quest.bounty_daily_woodcutting.title = Legname Giornaliero
quest.bounty_daily_woodcutting.flavor = Le segherie hanno sempre bisogno di altri tronchi. Porta alla bacheca un carico costante.
quest.bounty_daily_harvest.title = Raccolto Giornaliero
quest.bounty_daily_harvest.flavor = I prodotti freschi tengono nutriti gli accampamenti. Raccogli ciò che i campi offrono oggi.
quest.bounty_daily_fishing.title = Pesca Giornaliera
quest.bounty_daily_fishing.flavor = I cuochi vogliono pesce in tavola stasera. Lavora le acque.
quest.bounty_daily_monster_cull.title = Abbattimento Giornaliero
quest.bounty_daily_monster_cull.flavor = C'è sempre qualcosa da diradare. Ripulisci le terre selvagge da tutto ciò che incroci.
quest.bounty_daily_zombie_patrol.title = Pattuglia Zombie
quest.bounty_daily_zombie_patrol.flavor = I morti tornano a vagare troppo vicino alle mura. Rimettili giù.
quest.bounty_daily_bear_hunt.title = Caccia all'Orso
quest.bounty_daily_bear_hunt.flavor = Gli orsi razziano le scorte. La bacheca vuole che i più audaci siano abbattuti.
quest.bounty_daily_essence.title = Consegna di Essenza
quest.bounty_daily_essence.flavor = Gli alchimisti sono a corto di vita imbottigliata. Consegnane una partita alla bacheca.

# --- Bihourly board: short, fast-rotating contracts ---
