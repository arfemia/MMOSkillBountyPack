# === 1.4.0: training (daily-board) + bihourly contracts ===

# --- Board names + descriptions (board titleKey/descriptionKey) ---
ui.bounty.board.bihourly = Contratti Rapidi
ui.bounty.board.bihourly.desc = Un breve contratto che ruota più volte al giorno.

# --- Daily board: training (XP-grind) contracts ---
quest.bounty_daily_woodcutting.title = Legname Giornaliero
quest.bounty_daily_woodcutting.flavor = Le segherie hanno sempre bisogno di altri tronchi. Porta alla bacheca un carico costante.
quest.bounty_daily_harvest.title = Raccolto Giornaliero
quest.bounty_daily_harvest.flavor = I prodotti freschi tengono nutriti gli accampamenti. Raccogli ciò che i campi offrono oggi.
quest.bounty_daily_fishing.title = Pesca Giornaliera
quest.bounty_daily_fishing.flavor = I cuochi vogliono pesce in tavola stasera. Lavora le acque.
quest.bounty_daily_monster_cull.title = Abbattimento Giornaliero
quest.bounty_daily_monster_cull.flavor = C'è sempre qualcosa da diradare. Ripulisci le terre selvagge da tutto ciò che incroci.
quest.bounty_daily_zombie_patrol.title = Pattuglia Zombie
quest.bounty_daily_zombie_patrol.flavor = Di nuovo zombie al cancello. Qualcuno deve uscire là fuori.
quest.bounty_daily_bear_hunt.title = Orsi nelle Scorte
quest.bounty_daily_bear_hunt.flavor = Gli orsi razziano le scorte. La bacheca vuole che i più audaci siano abbattuti.
quest.bounty_daily_essence.title = Consegna di Essenza
quest.bounty_daily_essence.flavor = Gli alchimisti sono a corto di vita imbottigliata. Consegnane una partita alla bacheca.

# --- Bihourly board: short, fast-rotating contracts ---
quest.bounty_quick_build.title = Costruzione Rapida
quest.bounty_quick_build.flavor = Bisogna alzare qualche muro prima del prossimo turno. Dai una mano.
quest.bounty_quick_bones.title = Ossa Rapide
quest.bounty_quick_bones.flavor = Gli scheletri continuano a strisciare su verso il limitare del bosco. Buttane giù qualcuno.
quest.bounty_quick_ore.title = Scavo Rapido
quest.bounty_quick_ore.flavor = I fabbri vogliono rame, e lo vogliono subito. Lavora una vena.
quest.bounty_quick_logs.title = Taglio Rapido
quest.bounty_quick_logs.flavor = Una breve catasta di tronchi, il più in fretta che riesci ad abbatterli.
quest.bounty_quick_catch.title = Lancio Rapido
quest.bounty_quick_catch.flavor = Giusto il pesce necessario per completare la pentola. Lancia la lenza.
quest.bounty_quick_cull.title = Abbattimento Rapido
quest.bounty_quick_cull.flavor = Di nuovo guai vicino alla strada. Elimina tutto ciò che si nasconde in agguato.
quest.bounty_quick_rot.title = Marciume Rapido
quest.bounty_quick_rot.flavor = I morti barcollanti sono di nuovo spessi vicino alla strada. Abbattine qualcuno prima che la prossima pattuglia arrivi.

# --- Daily board: SPEND_CURRENCY showcase ---
quest.bounty_market_patron.title = Cliente del Mercato
quest.bounty_market_patron.flavor = Al banco gli affari vanno a rilento. Spendi un po' lì e la bacheca ti ripagherà.

# === 1.3.0: contratti stagionali (lo slot Stagionale della bacheca Giornaliera, pubblicato mentre è in corso un evento del calendario) ===

# --- La fascia Stagionale della bacheca Giornaliera (la sua voce in Grades) ---
board.grade.seasonal = Stagionale

# --- Bacheca giornaliera: contratti infestati della Vigilia di Ognissanti ---
quest.bounty_haunt_ghouls.title = Stagione dei Ghoul
quest.bounty_haunt_ghouls.flavor = I ghoul vuoti strisciano fuori solo finché le zucche sono accese, e puntano dritti alle strade. Rimettili sottoterra prima che la stagione cambi.
quest.bounty_haunt_skeletons.title = Teste di Zucca
quest.bounty_haunt_skeletons.flavor = Gli scheletri hanno preso a indossare zucche intagliate, e ogni notte girano per i campi ghignando verso le fattorie. Fagli saltare la testa e rimanda giù le ossa.
quest.bounty_haunt_souls.title = Anime Erranti
quest.bounty_haunt_souls.flavor = Dopo il tramonto le anime perdute vagano tra gli alberi, in cerca della strada di casa. Concedi loro il riposo prima che una di loro segua qualcuno fino in città.
