shop.cache_scaled_hide.desc = Pelli squamate, conciate e legate.
shop.featured_cache_iron.title = Grande Cassa di Ferro
shop.featured_cache_iron.desc = Più minerale di ferro di quanto il banco ne venda di solito.
shop.featured_cache_adamantite.title = Riserva d'Adamantio
shop.featured_cache_adamantite.desc = Una riserva di minerale d'adamantio, messa da parte per i combattenti navigati.
shop.featured_cache_essence.title = Fiale d'Essenza
shop.featured_cache_essence.desc = Essenza Vitale, imbottigliata a lotti.
shop.featured_cache_hides.title = Fascio di Pelli Leggere
shop.featured_cache_hides.desc = Pelli leggere a fasci, pronte per la conceria.
shop.featured_cache_lobster.title = Bottino del Pescatore
shop.featured_cache_lobster.desc = Aragoste dal pescato della settimana.
shop.featured_boost_combat.title = Vantaggio del Guerriero
shop.featured_boost_combat.desc = L'esperienza di Spade arriva più in fretta per un breve periodo.
shop.featured_boost_woodcutting.title = Frenesia del Boscaiolo
shop.featured_boost_woodcutting.desc = L'esperienza di Woodcutting arriva più in fretta per un breve periodo.
shop.xp_all_skills.title = Pacchetto XP Tutte le Abilita'
shop.xp_all_skills.desc = Un po' di esperienza in tutte le abilità insieme.
shop.boost_essence_surge.title = Ondata d'Essenza
shop.boost_essence_surge.desc = Ogni abilità impara più in fretta per un breve periodo.
shop.cache_iron_bars.title = Riserva del Fabbro
shop.cache_iron_bars.desc = Barre di ferro dalla riserva della gilda.
shop.featured_cache_enchanter.title = Pacco dell'Incantatore
shop.featured_cache_enchanter.desc = Frammenti di cristallo viola e blu, imballati nella paglia.

