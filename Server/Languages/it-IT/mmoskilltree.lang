# MMOSkillBountyPack - titoli delle taglie + testo descrittivo.
# Le chiavi sono nude; l'I18nModule di Hytale antepone il nome del file, quindi ognuna
# viene caricata come mmoskilltree.quest.<id>.title / .flavor ed e' raccolta dall'UI della
# Bacheca delle Taglie (BountyBoardPage risolve quest.<id>.title / quest.<id>.flavor per convenzione).
# Aggiungi un <locale>/mmoskilltree.lang con le stesse chiavi per tradurre; le chiavi mancanti
# ricadono sull'inglese per singola chiave.

# --- Giornaliere: uccidi ---
quest.bounty_swat_bats.title = Scaccia i Pipistrelli
quest.bounty_swat_bats.flavor = Le caverne pullulano di alivelo stanotte. Riduci lo sciame prima che metta su un nido.
quest.bounty_clear_spiders.title = Libera i Sentieri
quest.bounty_clear_spiders.flavor = I ragni hanno sigillato i vecchi sentieri con le ragnatele. Apri un varco prima che qualcuno ci finisca dentro a faccia avanti.
quest.bounty_slay_zombies.title = Falciata di Zombie
quest.bounty_slay_zombies.flavor = I morti senza pace vagano troppo vicino alla strada. Rimettili sotto terra.
quest.bounty_cull_skeletons.title = Fai Tremare le Ossa
quest.bounty_cull_skeletons.flavor = Gli scheletri risalgono dai tumuli a ogni tramonto. Rimandali giu' a pezzi.
quest.bounty_hunt_wolves.title = Caccia ai Lupi
quest.bounty_hunt_wolves.flavor = Un branco si e' fatto audace vicino ai pascoli. Cacciali prima che le mandrie ne paghino il prezzo.
quest.bounty_goblin_cleanup.title = Pulizia dei Goblin
quest.bounty_goblin_cleanup.flavor = I goblin razziano di nuovo i carri delle provviste. Sgombera la tana e ci penseranno due volte.
quest.bounty_cull_scaraks.title = Falciata di Scarak
quest.bounty_cull_scaraks.flavor = Gli Scarak risalgono ribollendo dalle dune. Falciali finche' sono ancora sparpagliati.
quest.bounty_hunt_trork.title = Caccia ai Trork
quest.bounty_hunt_trork.flavor = Le bande da guerra dei Trork si stanno radunando sulle colline. Spezza le loro fila prima che si organizzino.
quest.bounty_bear_hunt.title = Caccia all'Orso
quest.bounty_bear_hunt.flavor = Grandi orsi hanno reclamato il sentiero del nord. Questa e' solo per una mano ferma.
quest.bounty_smash_ogres.title = Sfracella gli Ogre
quest.bounty_smash_ogres.flavor = Gli ogre stanno sfondando le palizzate. Abbattili prima che le mura crollino con loro.
quest.bounty_snapdragon_hunt.title = Caccia alla Snapdragon
quest.bounty_snapdragon_hunt.flavor = Una lucertola velenosa si aggira tra i cespugli profondi, e nulla osa condividere il suo territorio di caccia. Traccia la Snapdragon prima che si avvicini agli insediamenti.
quest.bounty_burnt_skeletons.title = Cenere e Ossa
quest.bounty_burnt_skeletons.flavor = Scheletri carbonizzati vagano tra le rovine bruciate, ancora fumanti. Rimetti i morti bruciati a riposo.
quest.bounty_boar_hunt.title = Caccia ai Cinghiali
quest.bounty_boar_hunt.flavor = I cinghiali selvaggi calpestano i campi coltivati e feriscono chiunque si avvicini troppo. Diradi lo sciame prima della raccolta.

# --- Giornaliere: raccogli ---
quest.bounty_mine_stone.title = Lavoro in Cava
quest.bounty_mine_stone.flavor = I muratori hanno bisogno di pietra, e tanta. Dacci dentro col piccone.
quest.bounty_chop_wood.title = Legname!
quest.bounty_chop_wood.flavor = La segheria sta finendo le scorte. Abbatti quel che puoi e accatastalo in alto.
quest.bounty_mine_iron.title = Ferro per la Fucina
quest.bounty_mine_iron.flavor = I fabbri sono rimasti senza ferro. Riporta il minerale dalle vene profonde.
quest.bounty_mine_adamantite.title = Spedizione d'Adamantio
quest.bounty_mine_adamantite.flavor = L'adamantio giace solo nelle vene piu' profonde. Estrailo se osi sfidare l'oscurita'.
quest.bounty_cache_copper.title = Riserva di Rame
quest.bounty_cache_copper.flavor = La fonderia scambia lingotti appena fusi per rame grezzo. Porta il minerale, esci con il metallo.
quest.bounty_cache_repairs.title = Ferri del Mestiere
quest.bounty_cache_repairs.flavor = Spacca pietra per la cava e il fabbro ti rifila qualche kit di riparazione per il disturbo.

# --- Giornaliere: allena ---
quest.bounty_train_woodcutting.title = Affila l'Ascia
quest.bounty_train_woodcutting.flavor = La pratica rende il taglio piu' veloce. Passa la giornata al margine del bosco.
quest.bounty_train_mining.title = Tempra il Piccone
quest.bounty_train_mining.flavor = Il valore di un minatore si misura nei colpi. Mettici le ore.
quest.bounty_train_excavation.title = Scava in Profondita'
quest.bounty_train_excavation.flavor = Non ci sono scorciatoie per i calli di uno scavatore. Sposta un po' di terra.

# --- Giornaliere: consegna ---
quest.bounty_deliver_iron.title = Consegna di Ferro
quest.bounty_deliver_iron.flavor = Il furiere paga bene il ferro, senza fare domande. Portalo alla bacheca.
quest.bounty_deliver_hides.title = Carico di Pelli
quest.bounty_deliver_hides.flavor = I conciatori hanno bisogno di pelli leggere a carriolate. Scaricale qui.
quest.bounty_deliver_essence.title = Carico d'Essenza
quest.bounty_deliver_essence.flavor = L'essenza vitale imbottigliata vale una fortuna. Consegna la tua scorta.
quest.bounty_deliver_adamantite.title = Carico d'Adamantio
quest.bounty_deliver_adamantite.flavor = Mani raffinate vogliono adamantio, e solo il miglior minerale andra' bene.

# --- Settimanali ---
quest.bounty_weekly_slay_zombies.title = I Morti Senza Fine
quest.bounty_weekly_slay_zombies.flavor = Un'intera settimana di morti senza pace. Tieni la posizione finche' le tombe non torneranno silenziose.
quest.bounty_weekly_hunt_trork.title = Banda da Guerra Trork
quest.bounty_weekly_hunt_trork.flavor = Un'intera banda da guerra si e' accampata. Assottigliala nel corso della settimana.
quest.bounty_weekly_goblin_purge.title = Purga dei Goblin
quest.bounty_weekly_goblin_purge.flavor = La tana continua a sfornare goblin. Ci vuole una settimana di lavoro per diradarla davvero.
quest.bounty_weekly_mine_adamantite.title = Quota d'Adamantio
quest.bounty_weekly_mine_adamantite.flavor = Un contratto di una settimana per le fucine profonde. Raggiungi la quota.
quest.bounty_weekly_outlander.title = Taglia sugli Outlander
quest.bounty_weekly_outlander.flavor = Gli Outlander premono sui confini tutta la settimana. Respingili.
quest.bounty_weekly_burnt_legion.title = La Legione Bruciata
quest.bounty_weekly_burnt_legion.flavor = Morti carbonizzati marciano fuori dalle terre di cenere. Disperdi la legione una volta per tutte.
quest.bounty_weekly_wraiths.title = Caccia agli Spettri
quest.bounty_weekly_wraiths.flavor = Gli spettri scivolano tra questo mondo e l'altro. Bandiscine abbastanza da fare la differenza.
quest.bounty_weekly_werewolves.title = Sotto la Luna Piena
quest.bounty_weekly_werewolves.flavor = La luna e' piena tutta la settimana e il branco corre selvaggio. Poni fine alla maledizione.
quest.bounty_weekly_golems.title = Frantumatore di Golem
quest.bounty_weekly_golems.flavor = Antichi golem si sono risvegliati tra le rovine. Frantumali pietra dopo pietra.
quest.bounty_weekly_train_swords.title = Maestria con la Spada
quest.bounty_weekly_train_swords.flavor = Una settimana di esercitazioni separa un soldato da un maestro di spada. Allenati duramente.
quest.bounty_weekly_train_defense.title = Tieni la Posizione
quest.bounty_weekly_train_defense.flavor = La tenacia si guadagna colpo dopo colpo. Passa la settimana a incassare e restare saldo.
quest.bounty_weekly_sharks.title = Acque Insanguinate
quest.bounty_weekly_sharks.flavor = Gli squali martello hanno trasformato le rotte commerciali in un terreno di caccia. Riduci il branco prima che scompaia il prossimo equipaggio.
quest.bounty_weekly_leviathan.title = Il Leviatano
quest.bounty_weekly_leviathan.flavor = Qualcosa di immenso si muove sotto i flutti. Abbatti le grandi bestie prima che trascinino la flotta negli abissi.
quest.bounty_weekly_sand_skeletons.title = Ossa delle Dune
quest.bounty_weekly_sand_skeletons.flavor = Scheletri sospinti dalla sabbia risalgono dovunque il deserto inghiotte i morti. Passa la settimana a ripulire i sepolti dalle dune.
quest.bounty_weekly_frost_skeletons.title = L'Armata Gelata
quest.bounty_weekly_frost_skeletons.flavor = Un'armata legata dal gelo marcia giù dai ghiacciai, il respiro ricoperto di ghiaccio. Spezza le loro fila prima che il freddo si diffonda ancora.

# --- Hub / accoglienza (spedito qui cosi' i proprietari del server possono riscrivere ---
# --- l'accoglienza senza toccare il jar; il jar conserva questi valori inglesi come fallback per chiave). ---
ui.hub.subtitle = Cosa posso fare per te, avventuriero?
ui.hub.bounties_button = Vedi le Taglie
ui.hub.bounties_hint = Accetta contratti a rotazione per ottenere ricompense.
ui.hub.shop_button = Negozio Gettoni
ui.hub.tutorial.step = {0} / {1}
ui.hub.tutorial.next = Avanti
ui.hub.tutorial.back = Indietro
ui.hub.tutorial.finish = Capito!
ui.hub.tutorial.welcome.title = Benvenuto, avventuriero!
ui.hub.tutorial.welcome.body = Sono il Maestro delle Taglie. Parlami quando vuoi per accettare contratti e commerciare. Lascia che ti mostri come funziona.
ui.hub.tutorial.bounties.title = Taglie
ui.hub.tutorial.bounties.body = Le taglie sono contratti a rotazione: uccidi, raccogli o consegna per ottenere ricompense. Accettane una per aggiungerla al tuo diario delle missioni, completa l'obiettivo e guadagni gettoni piu' XP. La bacheca si aggiorna secondo una pianificazione, e puoi rigenerare un singolo contratto che non ti piace per qualche gettone.
ui.hub.tutorial.shop.title = Negozio Gettoni
ui.hub.tutorial.shop.body = Spendi i gettoni che guadagni al mio Negozio Gettoni: boost XP, oggetti e altro ancora. Alcune offerte in evidenza ruotano ogni giorno, e puoi rigenerare un'offerta in evidenza per sostituirla con un'altra.

# --- Nomi e descrizioni del negozio (shop.<id>.title / .desc, risolti per convenzione) ---
shop.general.title = Negozio Gettoni
shop.general.desc = Spendi i gettoni che ti sei sudato in boost, casse e offerte in evidenza.
shop.xpexchange.title = Scambio XP
shop.xpexchange.desc = Scambia i tuoi guadagni per un'ondata di XP abilita'.
shop.xpexchange.featured = Le Offerte XP di Oggi

# --- Nomi e descrizioni delle offerte (le offerte impostano titleKey/descriptionKey espliciti -> queste chiavi) ---
shop.boost_mining.title = Frenesia Mineraria
shop.boost_mining.desc = Un'ondata di istinto minerario concentrato; la roccia cede quasi da sola.
shop.boost_all_skills.title = Slancio Totale
shop.boost_all_skills.desc = Un'ondata di lucidita' che affina ogni abilita' che possiedi.
shop.cache_iron_ore.title = Cassa di Ferro
shop.cache_iron_ore.desc = Una cassa robusta di ferro, consegnata dritta nel tuo inventario.
shop.cache_adamantite_ore.title = Cassa di Adamantio
shop.cache_adamantite_ore.desc = Adamantio estratto dalle profondita', solo per combattenti navigati.
shop.cache_scaled_hide.title = Fascio di Pelli del Cacciatore
shop.cache_scaled_hide.desc = Pelli dure strappate ai cacciatori degli abissi.
shop.featured_cache_iron.title = In Evidenza: Cassa di Ferro
shop.featured_cache_iron.desc = Una cassa in evidenza di ferro appena estratto.
shop.featured_cache_adamantite.title = In Evidenza: Riserva d'Adamantio
shop.featured_cache_adamantite.desc = Una riserva in evidenza dalle vene piu' profonde.
shop.featured_cache_essence.title = In Evidenza: Fiale d'Essenza
shop.featured_cache_essence.desc = Una partita in evidenza di vita imbottigliata.
shop.featured_cache_hides.title = In Evidenza: Fascio di Pelli
shop.featured_cache_hides.desc = Un fascio in evidenza di pelli morbide.
shop.featured_cache_lobster.title = In Evidenza: Bottino del Pescatore
shop.featured_cache_lobster.desc = Un bottino in evidenza dal pescato della settimana.
shop.featured_boost_combat.title = Vantaggio del Guerriero
shop.featured_boost_combat.desc = La tua lama canta; ogni fendente ti insegna qualcosa.
shop.featured_boost_woodcutting.title = Frenesia del Boscaiolo
shop.featured_boost_woodcutting.desc = Il legname cade piu' in fretta di quanto tu riesca a contare.
shop.xp_all_skills.title = Pacchetto XP Tutte le Abilita'
shop.xp_all_skills.desc = Un pacchetto premium di XP per ogni abilita' in una sola volta.
shop.boost_essence_surge.title = Ondata d'Essenza
shop.boost_essence_surge.desc = Incanala la vita grezza in lucidita'; ogni abilita' impara piu' in fretta finche' dura.
shop.cache_iron_bars.title = Riserva del Fabbro
shop.cache_iron_bars.desc = Lingotti fusi dalla riserva della gilda, pagati in parte in essenza.
shop.featured_cache_enchanter.title = In Evidenza: Pacco dell'Incantatore
shop.featured_cache_enchanter.desc = Un pacco in evidenza di cristalli radiosi che ronzano di energia.

