# MMOSkillBountyPack - títulos de contratos + texto de ambientación.
# Las claves van sin prefijo; el I18nModule de Hytale antepone el nombre del archivo, así que cada una se carga como
# mmoskilltree.quest.<id>.title / .flavor y la recoge la interfaz del Tablón de Contratos
# (BountyBoardPage resuelve quest.<id>.title / quest.<id>.flavor por convención).
# Añade un <locale>/mmoskilltree.lang con las mismas claves para traducir; las claves que falten
# recurren al inglés clave por clave.

# --- Diario: matar ---
quest.bounty_swat_bats.title = Aplasta los Murciélagos
quest.bounty_swat_bats.flavor = Los murciélagos de las cuevas tienen a los mineros sobresaltados con cada sombra. Échalos de ahí.
quest.bounty_clear_spiders.title = Despeja las Telarañas
quest.bounty_clear_spiders.flavor = Las arañas han cerrado los viejos senderos con sus telas. Abre un paso antes de que alguien se choque de cara con una.
quest.bounty_slay_zombies.title = Sacrificio de Zombis
quest.bounty_slay_zombies.flavor = Los muertos inquietos vagan demasiado cerca del camino. Vuelve a tumbarlos.
quest.bounty_cull_skeletons.title = Sacude los Huesos
quest.bounty_cull_skeletons.flavor = Los esqueletos trepan de las tumbas cada anochecer. Devuélvelos hechos pedazos.
quest.bounty_hunt_wolves.title = Caza de Lobos
quest.bounty_hunt_wolves.flavor = Los lobos han vuelto a atacar a las ovejas. Da caza a la manada.
quest.bounty_goblin_cleanup.title = Limpieza de Goblins
quest.bounty_goblin_cleanup.flavor = Los goblins vuelven a asaltar los carros de suministros. Despeja la madriguera y se lo pensarán dos veces.
quest.bounty_cull_scaraks.title = Sacrificio de Scaraks
quest.bounty_cull_scaraks.flavor = Los Scaraks brotan de las dunas. Sacrifícalos mientras siguen dispersos.
quest.bounty_hunt_trork.title = Caza de Trorks
quest.bounty_hunt_trork.flavor = Los Trorks no dejan de bajar de sus campamentos en las colinas para asaltar el camino. Sube a recibirlos.
quest.bounty_bear_hunt.title = Caza del Oso
quest.bounty_bear_hunt.flavor = Grandes osos se han adueñado del sendero del norte. Esta solo es para un pulso firme.
quest.bounty_smash_ogres.title = Aplasta Ogros
quest.bounty_smash_ogres.flavor = Los carpinteros han reconstruido la empalizada dos veces esta semana. Abate a los ogros que la echan abajo.
quest.bounty_snapdragon_hunt.title = Caza de Snapdragons
quest.bounty_snapdragon_hunt.flavor = Los Snapdragons tienen los senderos de la jungla para ellos solos, y los cazadores no se acercan. Abate a unos cuantos, y cuidado con el mordisco.
quest.bounty_burnt_skeletons.title = Ceniza y Hueso
quest.bounty_burnt_skeletons.flavor = Esqueletos carbonizados vagan por las ruinas chamuscadas, aún humeantes. Devuelve a los muertos quemados al descanso.
quest.bounty_boar_hunt.title = Caza del Jabalí
quest.bounty_boar_hunt.flavor = Los jabalíes salvajes pisotean los campos de cultivo e hieren a quien se acerca demasiado. Mengua la piara antes de la cosecha.

# --- Diario: recolectar ---
quest.bounty_mine_stone.title = Trabajo de Cantera
quest.bounty_mine_stone.flavor = Los albañiles necesitan piedra, y mucha. Empieza a picar.
quest.bounty_chop_wood.title = ¡Árbol Va!
quest.bounty_chop_wood.flavor = El aserradero se está quedando sin existencias. Tala lo que puedas y apílalo bien alto.
quest.bounty_mine_iron.title = Hierro para la Forja
quest.bounty_mine_iron.flavor = Los herreros se han quedado sin hierro. Trae mineral de las vetas profundas.
quest.bounty_mine_adamantite.title = Búsqueda de Adamantita
quest.bounty_mine_adamantite.flavor = La adamantita solo descansa en las vetas más profundas. Lleva antorchas de sobra.
quest.bounty_cache_copper.title = Alijo de Cobre
quest.bounty_cache_copper.flavor = Abre unas cuantas vetas de cobre para la fundición. Pagan en lingotes.
quest.bounty_cache_repairs.title = Herramientas del Oficio
quest.bounty_cache_repairs.flavor = Pica piedra para la cantera y el herrero te añadirá unos cuantos kits de reparación por las molestias.

# --- Diario: entrenar ---
quest.bounty_train_woodcutting.title = Afila el Hacha
quest.bounty_train_woodcutting.flavor = Hoy el almacén de madera paga las horas de hacha. Pásalas en la linde del bosque.
quest.bounty_train_mining.title = Adiestra el Pico
quest.bounty_train_mining.flavor = Hoy la cantera paga por horas. Pasa el día rompiendo roca.
quest.bounty_train_excavation.title = Cava Hondo
quest.bounty_train_excavation.flavor = Alguien quiere mover mucha tierra y no le importa de dónde. A cavar.

# --- Diario: entregar ---
quest.bounty_deliver_iron.title = Entrega de Hierro
quest.bounty_deliver_iron.flavor = El intendente compra mineral de hierro a carretadas. Tráelo al tablón.
quest.bounty_deliver_hides.title = Acarreo de Pieles
quest.bounty_deliver_hides.flavor = Los curtidores necesitan pieles ligeras a carretadas. Déjalas aquí.
quest.bounty_deliver_essence.title = Consignación de Esencia
quest.bounty_deliver_essence.flavor = Los alquimistas pagan bien la esencia vital. Entrega la que tengas.
quest.bounty_deliver_adamantite.title = Consignación de Adamantita
quest.bounty_deliver_adamantite.flavor = Las forjas profundas quieren mineral de adamantita en bruto y lo pagan bien. Entrégalo en el tablón.

# --- Semanal ---
quest.bounty_weekly_slay_zombies.title = Los Muertos Sin Fin
quest.bounty_weekly_slay_zombies.flavor = Una semana entera de muertos inquietos. Aguanta la línea hasta que las tumbas vuelvan a la calma.
quest.bounty_weekly_hunt_trork.title = Banda de Guerra Trork
quest.bounty_weekly_hunt_trork.flavor = Una banda de guerra completa ha montado campamento. Méngualos a lo largo de la semana.
quest.bounty_weekly_goblin_purge.title = Purga de Goblins
quest.bounty_weekly_goblin_purge.flavor = La madriguera no para de reproducirse. Mermarla lleva la semana entera.
quest.bounty_weekly_mine_adamantite.title = Cupo de Adamantita
quest.bounty_weekly_mine_adamantite.flavor = Un contrato de una semana para las forjas profundas. Cumple el cupo.
quest.bounty_weekly_outlander.title = Recompensa Outlander
quest.bounty_weekly_outlander.flavor = Los saqueadores Outlander han estado atacando las granjas de las afueras. Hazlos retroceder.
quest.bounty_weekly_burnt_legion.title = La Legión Calcinada
quest.bounty_weekly_burnt_legion.flavor = Muertos carbonizados marchan desde las tierras de ceniza. Dispersa la legión para siempre.
quest.bounty_weekly_wraiths.title = Caza de Espectros
quest.bounty_weekly_wraiths.flavor = Hay demasiados espectros sueltos. Abate a los suficientes para que la gente vuelva a viajar.
quest.bounty_weekly_werewolves.title = Bajo la Luna Llena
quest.bounty_weekly_werewolves.flavor = La luna está llena toda la semana y la manada anda desbocada. Dales caza.
quest.bounty_weekly_golems.title = Rompególems
quest.bounty_weekly_golems.flavor = Los gólems de las ruinas se han puesto en pie y caminan. Vuelve a dejarlos en escombros.
quest.bounty_weekly_train_swords.title = Maestría con la Espada
quest.bounty_weekly_train_swords.flavor = Una semana de instrucción con la espada, sin saltarse un día. Golpea cosas hasta que el brazo se sepa el oficio.
quest.bounty_weekly_train_defense.title = Aguanta la Línea
quest.bounty_weekly_train_defense.flavor = Pasa la semana encajando golpes y aguantando en pie. Lleva vendas.
quest.bounty_weekly_sharks.title = Aguas Ensangrentadas
quest.bounty_weekly_sharks.flavor = Los pescadores quieren a los tiburones martillo fuera de los arrecifes cálidos. Nada que merezca la pena pescar se queda donde ellos nadan.
quest.bounty_weekly_leviathan.title = Caza de Ballenas
quest.bounty_weekly_leviathan.flavor = Alguien costa arriba quiere ballena, y nadie más va a remar tan lejos. Busca a las jorobadas en mar abierto.
quest.bounty_weekly_sand_skeletons.title = Huesos de las Dunas
quest.bounty_weekly_sand_skeletons.flavor = Esqueletos barridos por la arena trepan donde el desierto traga a los muertos. Pasa la semana despejando la hueste enterrada de las dunas.
quest.bounty_weekly_frost_skeletons.title = La Hueste Congelada
quest.bounty_weekly_frost_skeletons.flavor = Esqueletos helados bajan en marcha desde los glaciares. Hazlos pedazos antes de que lleguen a los valles.

# --- Eje / iniciación (se incluye aquí para que los dueños del servidor puedan reformular la iniciación sin ---
