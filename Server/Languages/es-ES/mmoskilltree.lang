shop.boost_mining.title = Fiebre Minera
shop.boost_mining.desc = Una ráfaga de instinto minero concentrado; la roca prácticamente cede sola.
shop.boost_all_skills.title = Oleada de Todas las Habilidades
shop.boost_all_skills.desc = Una oleada de lucidez que agudiza todas tus habilidades.
shop.cache_iron_ore.title = Cajón de Hierro
shop.cache_iron_ore.desc = Un cajón robusto de hierro, entregado directamente a tu inventario.
shop.cache_adamantite_ore.title = Cajón de Adamantita
shop.cache_adamantite_ore.desc = Adamantita extraída de las profundidades, solo para luchadores experimentados.
shop.cache_scaled_hide.title = Fardo de Pieles del Cazador
shop.cache_scaled_hide.desc = Pieles duras arrancadas a los cazadores de las profundidades.
shop.featured_cache_iron.title = Destacado: Cajón de Hierro
shop.featured_cache_iron.desc = Un cajón destacado de hierro recién extraído.
shop.featured_cache_adamantite.title = Destacado: Reserva de Adamantita
shop.featured_cache_adamantite.desc = Una reserva destacada de las vetas más profundas.
shop.featured_cache_essence.title = Destacado: Viales de Esencia
shop.featured_cache_essence.desc = Un lote destacado de vida embotellada.
shop.featured_cache_hides.title = Destacado: Fardo de Pieles
shop.featured_cache_hides.desc = Un fardo destacado de pieles flexibles.
shop.featured_cache_lobster.title = Destacado: Botín del Pescador
shop.featured_cache_lobster.desc = Un botín destacado de la pesca de la semana.
shop.featured_boost_combat.title = Filo del Guerrero
shop.featured_boost_combat.desc = Tu hoja canta; cada tajo te enseña algo.
shop.featured_boost_woodcutting.title = Frenesí del Leñador
shop.featured_boost_woodcutting.desc = La madera cae más rápido de lo que puedes contar.
shop.xp_all_skills.title = Lote de XP de Todas las Habilidades
shop.xp_all_skills.desc = Un lote premium de XP para todas las habilidades a la vez.
shop.boost_essence_surge.title = Oleada de Esencia
shop.boost_essence_surge.desc = Canaliza vida en estado puro hacia la lucidez; todas las habilidades aprenden más rápido mientras dura.
shop.cache_iron_bars.title = Reserva del Herrero
shop.cache_iron_bars.desc = Barras fundidas de la reserva del gremio, pagadas en parte con esencia.
shop.featured_cache_enchanter.title = Destacado: Paquete del Encantador
shop.featured_cache_enchanter.desc = Un paquete destacado de cristales radiantes que zumban de energía.

