shop.featured_cache_lobster.title = Botín del Pescador
shop.featured_cache_lobster.desc = Langosta de la pesca de la semana.
shop.featured_boost_combat.title = Filo del Guerrero
shop.featured_boost_combat.desc = La experiencia de Espadas llega más rápido durante un rato.
