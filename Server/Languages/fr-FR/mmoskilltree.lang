shop.featured_cache_hides.title = À la une : lot de peaux
shop.featured_cache_hides.desc = Un lot à la une de 48 peaux légères.
shop.featured_cache_lobster.title = À la une : prise de homards
shop.featured_cache_lobster.desc = Une prise à la une de 24 homards de la pêche de la semaine.
shop.featured_boost_combat.title = Tranchant du guerrier (2x épées, 30m)
shop.featured_boost_combat.desc = Double l'XP d'épées pendant 30 minutes.
shop.featured_boost_woodcutting.title = Frénésie du bûcheron (3x bûcheronnage, 20m)
