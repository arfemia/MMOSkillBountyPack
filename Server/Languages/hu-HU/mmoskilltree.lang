shop.featured_cache_hides.title = Kiemelt: Bőrköteg
shop.featured_cache_hides.desc = Egy kiemelt köteg 48 Könnyű Bőr.
shop.featured_cache_lobster.title = Kiemelt: Homárfogás
shop.featured_cache_lobster.desc = Egy kiemelt fogás 24 Homár a heti zsákmányból.
shop.featured_boost_combat.title = Harcos Éle (2x Kardok, 30p)
shop.featured_boost_combat.desc = Megduplázza a Kardok XP-t 30 percre.
shop.featured_boost_woodcutting.title = Favágó Tombolás (3x Favágás, 20p)
shop.featured_boost_woodcutting.desc = Megháromszorozza a Favágás XP-t 20 percre.
shop.xp_all_skills.title = Összes Képesség XP Csomag
shop.xp_all_skills.desc = Egy prémium XP-csomag minden képességhez egyszerre.

