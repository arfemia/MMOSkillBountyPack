shop.cache_adamantite_ore.title = Láda Adamantitérc
shop.cache_adamantite_ore.desc = Egy láda 12 Adamantitérc. Csak tapasztalt harcosoknak.
shop.cache_scaled_hide.title = Köteg Pikkelyes Bőr
shop.cache_scaled_hide.desc = Egy köteg 16 Pikkelyes Bőr, a mély vadászokról lehúzva.
shop.featured_cache_iron.title = Kiemelt: Vasláda
