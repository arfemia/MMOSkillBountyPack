shop.boost_mining.desc = Egy rövid ideig gyorsabban gyűlik a Bányászat XP.
shop.boost_all_skills.title = Összes Képesség Lendület
shop.boost_all_skills.desc = Egy ideig minden képesség gyorsabban fejlődik.
shop.cache_iron_ore.title = Vasláda
shop.cache_iron_ore.desc = Vasérc, ládaszám.
shop.cache_adamantite_ore.title = Adamantitláda
shop.cache_adamantite_ore.desc = Adamantitérc a mély bányákból, csak tapasztalt harcosoknak árulják.
shop.cache_scaled_hide.title = Pikkelyes Bőrköteg
shop.cache_scaled_hide.desc = Pikkelyes bőrök, kikészítve és összekötve.
shop.featured_cache_iron.title = Nagy Vasláda
shop.featured_cache_iron.desc = Több vasérc, mint amennyit a pult általában árul.
shop.featured_cache_adamantite.title = Adamantit Készlet
shop.featured_cache_adamantite.desc = Egy készlet adamantitérc, tapasztalt harcosoknak félretéve.
shop.featured_cache_essence.title = Esszencia Fiolák
shop.featured_cache_essence.desc = Életesszencia, adagonként palackozva.
shop.featured_cache_hides.title = Könnyű Bőrköteg
shop.featured_cache_hides.desc = Könnyű bőrök kötegszám, a cserzőműhelynek előkészítve.
shop.featured_cache_lobster.title = Halászzsákmány
shop.featured_cache_lobster.desc = Homár a heti fogásból.
shop.featured_boost_combat.title = Harcos Éle
shop.featured_boost_combat.desc = Egy rövid ideig gyorsabban gyűlik a Kardok XP.
shop.featured_boost_woodcutting.title = Favágó Tombolás
shop.featured_boost_woodcutting.desc = Egy rövid ideig gyorsabban gyűlik a Favágás XP.
shop.xp_all_skills.title = Összes Képesség XP Csomag
shop.xp_all_skills.desc = Egy kevés XP minden képességhez egyszerre.
shop.boost_essence_surge.title = Esszencia Hullám
shop.boost_essence_surge.desc = Egy rövid ideig minden képesség gyorsabban fejlődik.
shop.cache_iron_bars.title = Kovács Tartaléka
shop.cache_iron_bars.desc = Vasrudak a céh tartalékából.
shop.featured_cache_enchanter.title = Bűvölő Csomagja
shop.featured_cache_enchanter.desc = Lila és kék kristályszilánkok, szalmába csomagolva.

