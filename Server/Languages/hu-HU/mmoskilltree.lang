# === 1.4.0: training (daily-board) + bihourly contracts ===

# --- Board names + descriptions (board titleKey/descriptionKey) ---
ui.bounty.board.bihourly = Gyors szerződések
ui.bounty.board.bihourly.desc = Rövid szerződés, amely naponta többször is cserélődik.

# --- Daily board: training (XP-grind) contracts ---
quest.bounty_daily_woodcutting.title = Napi fakitermelés
quest.bounty_daily_woodcutting.flavor = A fűrésztelepeknek mindig több rönkre van szükségük. Hozz a táblának kiadós szállítmányt.
quest.bounty_daily_harvest.title = Napi betakarítás
quest.bounty_daily_harvest.flavor = A friss termés tartja jól a táborokat. Gyűjtsd be, amit a földek ma kínálnak.
quest.bounty_daily_fishing.title = Napi fogás
quest.bounty_daily_fishing.flavor = A szakácsok halat akarnak az asztalra ma estére. Dolgozd meg a vizeket.
quest.bounty_daily_monster_cull.title = Napi gyérítés
quest.bounty_daily_monster_cull.flavor = Mindig akad valami, amit ritkítani kell. Tisztítsd meg a vadont mindentől, ami az utadba kerül.
quest.bounty_daily_zombie_patrol.title = Zombijárőr
quest.bounty_daily_zombie_patrol.flavor = Megint zombik a kapunál. Valakinek ki kell mennie.
quest.bounty_daily_bear_hunt.title = Medvék a Raktárban
quest.bounty_daily_bear_hunt.flavor = A medvék fosztogatják a raktárakat. A tábla a legmerészebbek leterítését kéri.
quest.bounty_daily_essence.title = Eszencia-szállítmány
quest.bounty_daily_essence.flavor = Az alkimistáknak fogytán az üvegezett életerő. Adj le egy adagot a táblánál.

# --- Bihourly board: short, fast-rotating contracts ---
quest.bounty_quick_build.title = Gyors építés
quest.bounty_quick_build.flavor = Pár falat fel kell húzni a következő műszak előtt. Segíts be.
quest.bounty_quick_bones.title = Gyors csontozás
quest.bounty_quick_bones.flavor = A csontvázak folyton felmásznak a fák szélénél. Verj le párat.
quest.bounty_quick_ore.title = Gyors ásás
quest.bounty_quick_ore.flavor = A kovácsok rezet akarnak, méghozzá most. Fejts ki egy eret.
quest.bounty_quick_logs.title = Gyors favágás
quest.bounty_quick_logs.flavor = Egy rövid rakás rönk, olyan gyorsan, ahogy csak ki tudod dönteni őket.
quest.bounty_quick_catch.title = Gyors horgászás
quest.bounty_quick_catch.flavor = Épp annyi hal, hogy teljen az üst. Dobd be a zsineget.
quest.bounty_quick_cull.title = Gyors gyérítés
quest.bounty_quick_cull.flavor = Megint baj van az út mellett. Takaríts el mindent, ami ott ólálkodik.
quest.bounty_quick_rot.title = Gyors Rothadás
quest.bounty_quick_rot.flavor = A nyughatatlan holtak ismét sűrűn járőröznek az út mellett. Terítsd le párat, mielőtt a járőr csapat érkezik.

# --- Daily board: SPEND_CURRENCY showcase ---
quest.bounty_market_patron.title = A piac törzsvendége
quest.bounty_market_patron.flavor = Lassú a forgalom a pultnál. Költs el ott egy keveset, és a tábla visszafizeti neked.

# === 1.3.0: szezonális szerződések (a Napi tábla Szezonális helye, amíg egy naptári esemény tart) ===

# --- A Napi tábla Szezonális sávja (a Grades bejegyzése) ---
board.grade.seasonal = Szezonális

# --- Napi tábla: Mindenszentek Éje kísértetjárás-szerződések ---
quest.bounty_haunt_ghouls.title = Ghúlszezon
quest.bounty_haunt_ghouls.flavor = A kongó ghúlok csak akkor másznak elő, amikor égnek a tökök, és egyenesen az utaknak tartanak. Tedd vissza őket a földbe, mielőtt véget ér a szezon.
quest.bounty_haunt_skeletons.title = Tökfejek
quest.bounty_haunt_skeletons.flavor = A csontvázak rászoktak, hogy faragott tököt hordjanak, és minden éjjel a tanyaházakra vigyorogva járják a földeket. Üsd le a fejüket, és küldd vissza a csontokat a föld alá.
quest.bounty_haunt_souls.title = Bolyongó lelkek
quest.bounty_haunt_souls.flavor = Az elveszett lelkek sötétedés után a fák között sodródnak, és a hazautat keresik. Adj nekik nyugodalmat, mielőtt valamelyik utánamegy valakinek a városba.
