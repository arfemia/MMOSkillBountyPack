shop.featured_boost_excavation.title = Ásó Buzgalma
shop.featured_boost_excavation.desc = Egy rövid ideig gyorsabban gyűlik az Ásás XP.

# === 1.0.0 tartalombővítés: új mob-vadászatok, gyűjtés-és-leadás, boss szerződések ===

# --- Napi: új ölés ---
quest.bounty_scorpion_sweep.title = Skorpiósöprés
quest.bounty_scorpion_sweep.flavor = A skorpiók befészkelték magukat a dűnék alá, és a karavánok meg akarnak szabadulni tőlük. Tipord el a rajt.
quest.bounty_cull_cactee.title = Vándorló Kakteák
quest.bounty_cull_cactee.flavor = A kakteák kihúzták a gyökerüket, és a síkságon kóborolnak. Vágd ki őket, mielőtt elérik az utat.
quest.bounty_toad_rumble.title = Varangyháború
quest.bounty_toad_rumble.flavor = Az orrszarvú varangyok mindenkit elűznek az itatótól. Verd le a nagyokat.
quest.bounty_hunt_crocodile.title = Krokodilvadászat
quest.bounty_hunt_crocodile.flavor = A krokodilok beosontak a gázlóba, ahol az emberek átkelnek. Tisztítsd meg a partot, mielőtt valaki lábát veszti.
quest.bounty_sabertooth_hunt.title = Kardfogúvadászat
quest.bounty_sabertooth_hunt.flavor = Egy kardfogú falka elfoglalta a hegyi ösvényt. Tartsd a távolságot, és használj íjat.
quest.bounty_raptor_cull.title = Raptorritkítás
quest.bounty_raptor_cull.flavor = A barlangi raptorok falkában vadásznak az ásatás körül. Ritkítsd meg őket, hogy a bányászok dolgozhassanak.
quest.bounty_ghoul_purge.title = Ghúltisztogatás
quest.bounty_ghoul_purge.flavor = A ghúlok alulról vájják ki a régi temetőt. Tedd el a dögevőket egyszer s mindenkorra.
quest.bounty_emberwulf_hunt.title = Parázsfarkas-vadászat
quest.bounty_emberwulf_hunt.flavor = A parázsfarkasok lángra lobbantják a száraz fenyveseket, amerre csak járnak. Terítsd le őket, mielőtt a gerinc lángba borul.

# --- Napi: új gyűjtés (bányászd és add le) ---
quest.bounty_mine_silver.title = Ezüstszállítmány
quest.bounty_mine_silver.flavor = A pénzverdének kevés az ezüstje, és a vizsgáló egy részt kér belőle. Dolgozd le a teléreket, majd adj le egy részt a táblánál.

# --- Heti: új ölés ---
quest.bounty_weekly_fen_stalkers.title = A Láp Cserkészei
quest.bounty_weekly_fen_stalkers.flavor = A lápi cserkészek folyton a mocsárba hurcolják a jószágot. Menj be utánuk.
quest.bounty_weekly_feran_pack.title = A Feran Falka
quest.bounty_weekly_feran_pack.flavor = Élesfogú Feranok foglalták el a gerincet, és mindenkire rátámadnak, aki átkel rajta. Vadászd le őket.
quest.bounty_weekly_yeti.title = A Csúcsok Jetije
quest.bounty_weekly_yeti.flavor = A jetik lejöttek a fehér csúcsokról, és a hágók már nem biztonságosak. Űzd vissza őket a hóba.
quest.bounty_weekly_trillodon.title = A Trillodon
quest.bounty_weekly_trillodon.flavor = Trillodonok tapossák le a dzsungelt a folyó és a gerinc között. Terítsd le a behemótokat.
quest.bounty_weekly_spirits.title = Nyughatatlan Szellemek
quest.bounty_weekly_spirits.flavor = A szellemek megint összegyűltek az elemi köröknél, és nem szeretik a látogatókat. Takarítsd ki őket.
quest.bounty_weekly_voidspawn.title = Űrszülött Betörés
quest.bounty_weekly_voidspawn.flavor = Az űr ismét átszivárog a hasadékon. Vágd le, ami kimászik, mielőtt a rés kiszélesedik.
quest.bounty_weekly_mine_gold.title = Aranykvóta
quest.bounty_weekly_mine_gold.flavor = Arany a kincstárnak, és számolják. Bányássz bőven, és add le a részüket.

# --- Boss vadászatok (nehéz, nagy jutalom) ---
quest.bounty_aberrant_horror.title = Aberráns Rémség
quest.bounty_aberrant_horror.flavor = Valami megrontotta a holtakat keleten, és az aberránsak nem esnek el könnyen. Üsd őket, amíg el nem esnek.
quest.bounty_weekly_goblin_duke.title = A Goblin Herceg
quest.bounty_weekly_goblin_duke.flavor = Az odú most egy koronás szörnyetegnek engedelmeskedik. Végezz a Herceggel, és a rajtaütések is vele érnek véget.
quest.bounty_weekly_shadow_knight.title = Elesett Lovagok
quest.bounty_weekly_shadow_knight.flavor = Csontváz lovagok járják még mindig a romokat a régi páncéljukban, feltartott pajzzsal. Vigyél barátokat, és valami nehezet.
quest.bounty_weekly_broodmother.title = A Költőanya
quest.bounty_weekly_broodmother.flavor = A dűnék minden Scarakja egyetlen duzzadt királynőből kel ki. Találd meg a mély fészekben, és öld meg.

# --- Főellenség-harcok (Bounty_Encounter megbízások: bármelyik szkriptelt főellenség számít) ---
quest.bounty_weekly_open_warrant.title = Nyílt Megbízás
quest.bounty_weekly_open_warrant.flavor = Ezen nincs név. Bármi megteszi, ami elég nagy ahhoz, hogy csapat kelljen hozzá, amíg még talpon állsz a harcban, amikor elesik.
quest.bounty_muster_roll.title = Névsorolvasás
quest.bounty_muster_roll.flavor = Senki sem kéri, hogy nyerj. Állj helyt egy főellenség-harcban, amíg el nem dől, bárhogy is végződik, és a tábla jelenlévőnek jegyez.
